# SoftPh-Academico — single environment file for frontend and backend.
# Copy to .env (never commit .env) and fill in local values.

# --- Application ---------------------------------------------------------
# development | test | production (API docs are disabled in production)
APP_ENV=development

# --- Frontend (Astro SSR) ------------------------------------------------
# Internal URL Astro uses to reach FastAPI from the server side (SSR,
# middleware) and as the /api/v1 dev-proxy target. Not exposed to browsers.
API_INTERNAL_URL=http://127.0.0.1:8000

# Single public origin (frontend + API) seen by the browser. State-changing
# requests must come from it (Origin/Referer check). Browse with this exact
# host: http://127.0.0.1:4321 is a different origin than http://localhost:4321.
APP_ORIGIN=http://localhost:4321

# --- Sessions (HU-002) -----------------------------------------------------
# false is only accepted with APP_ENV development/test and an APP_ORIGIN on
# http://localhost, http://127.0.0.1 or http://[::1]. With APP_ENV=production
# it must be true, or the API and create-admin refuse to start.
SESSION_COOKIE_SECURE=false
SESSION_ABSOLUTE_TTL_MINUTES=480
SESSION_IDLE_TTL_MINUTES=30

# --- Failed login control (HU-002) ----------------------------------------
# N failures within the window lock the email for the lockout period.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# Simultaneous Argon2 password operations (64 MiB each), run outside the
# event loop. Range 1-4.
PASSWORD_HASH_MAX_CONCURRENCY=2

# --- MySQL 8.4 LTS (local) -----------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=softph_academico
DB_USER=softph_academico
DB_PASSWORD=change-me

# Dedicated test database. Must end in "_test" and differ from DB_NAME.
TEST_DB_NAME=softph_academico_test
