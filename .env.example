# SoftPh-Academico — single environment file for frontend and backend.
# Copy to .env (never commit .env) and fill in local values.

# --- Application ---------------------------------------------------------
# development | test | production (API docs are disabled in production)
APP_ENV=development

# --- Frontend (Astro SSR) ------------------------------------------------
# Internal URL Astro uses to reach FastAPI from the server side (SSR,
# middleware) and as the /api/v1 dev-proxy target. Not exposed to browsers.
API_INTERNAL_URL=http://127.0.0.1:8000

# --- MySQL 8.4 LTS (local) -----------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=softph_academico
DB_USER=softph_academico
DB_PASSWORD=change-me

# Dedicated test database. Must end in "_test" and differ from DB_NAME.
TEST_DB_NAME=softph_academico_test
