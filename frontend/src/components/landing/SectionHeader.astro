---
// The heading block of a landing section: eyebrow, h2 (with the id the section is labelled by) and an
// optional introduction, centered or aligned to the start.
import { EYEBROW } from '../../lib/landing/ui';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  intro?: string;
  align?: 'center' | 'start';
}

const { id, eyebrow, title, intro, align = 'center' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  <p class={EYEBROW}>{eyebrow}</p>
  <h2 id={id} class="mt-3 text-[1.625rem] font-bold leading-[2.125rem] tracking-tight text-slate-900 sm:text-[2rem] sm:leading-10">
    {title}
  </h2>
  {intro && <p class="mt-4 text-base leading-7 text-slate-600 sm:text-lg sm:leading-8">{intro}</p>}
</div>
