---
import LogoutButton from './LogoutButton.astro';
import Icon from './landing/Icon.astro';
import Logo from './landing/Logo.astro';
import { FOCUS_RING, buttonClasses } from '../lib/landing/ui';
import { demoPaymentsEnabled } from '../lib/resident/demo-payment-flag-server';

interface Props {
  csrfToken: string;
}

// The resident's navigation (HU-007 panel; HU-014 account statement; HU-008 payments; HU-009 feedback;
// HU-010 demo payment, only while DEMO_PAYMENTS_ENABLED; HU-017 notifications). Same layout as AdminHeader.
const { csrfToken } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/resident', label: 'Inicio', active: path === '/resident' || path === '/resident/' },
  { href: '/resident/account-statement', label: 'Estado de cuenta', active: path.startsWith('/resident/account-statement') },
  { href: '/resident/payments', label: 'Mis pagos', active: path.startsWith('/resident/payments') },
  ...(demoPaymentsEnabled()
    ? [{ href: '/resident/demo-payments', label: 'Pago de demostración', active: path.startsWith('/resident/demo-payments') }]
    : []),
  { href: '/resident/feedback', label: 'Mis feedback', active: path.startsWith('/resident/feedback') },
  { href: '/resident/notifications', label: 'Notificaciones', active: path.startsWith('/resident/notifications') }
];

// Every link and button keeps a 44 px touch area. Below 1024 px the links and the logout fold into a menu
// button (aria-expanded; Escape or a chosen link close it), as on the landing page.
const linkBase = `inline-flex min-h-11 items-center whitespace-nowrap rounded-md px-3 text-sm transition-colors motion-reduce:transition-none ${FOCUS_RING}`;
---

<header class="border-b border-slate-200 bg-white" data-resident-header>
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6 lg:px-8">
    <p class="flex items-center gap-2">
      <Logo />
      <span class="hidden rounded-full border border-teal-200 bg-teal-50 px-2 py-0.5 sm:inline text-[0.6875rem] font-bold uppercase tracking-wider text-teal-800">
        Residente
      </span>
    </p>
    <nav aria-label="Principal" class="order-last hidden w-full lg:block xl:order-none xl:w-auto">
      <ul class="-mx-3 flex flex-wrap gap-x-1 xl:mx-0">
        {
          links.map(({ href, label, active }) => (
            <li>
              <a
                href={href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  linkBase,
                  active ? 'bg-teal-50 font-semibold text-teal-800' : 'font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900'
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="hidden lg:block">
      <LogoutButton csrfToken={csrfToken} class={`${buttonClasses('secondary')} disabled:opacity-60`}>
        <Icon slot="icon" name="logOut" class="h-4 w-4 text-slate-500" />
      </LogoutButton>
    </div>

    <button
      type="button"
      class={`inline-flex h-11 w-11 items-center justify-center rounded-md text-slate-700 hover:bg-slate-100 lg:hidden ${FOCUS_RING}`}
      aria-expanded="false"
      aria-controls="resident-menu"
      data-menu-button
    >
      <span class="sr-only" data-menu-label>Abrir menú</span>
      <span data-menu-open><Icon name="menu" class="h-6 w-6" /></span>
      <span data-menu-close class="hidden"><Icon name="x" class="h-6 w-6" /></span>
    </button>
  </div>

  <div id="resident-menu" class="hidden border-t border-slate-200 bg-white lg:hidden" data-menu>
    <nav aria-label="Principal" class="mx-auto max-w-7xl px-4 py-3 sm:px-6">
      <ul class="space-y-1">
        {
          links.map(({ href, label, active }) => (
            <li>
              <a
                href={href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  `flex min-h-11 items-center rounded-md px-3 text-base transition-colors motion-reduce:transition-none ${FOCUS_RING}`,
                  active ? 'bg-teal-50 font-semibold text-teal-800' : 'font-medium text-slate-700 hover:bg-slate-50 hover:text-slate-900'
                ]}
                data-menu-link
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-3 border-t border-slate-200 pt-4">
        <LogoutButton csrfToken={csrfToken} class={`${buttonClasses('secondary')} w-full disabled:opacity-60`}>
          <Icon slot="icon" name="logOut" class="h-4 w-4 text-slate-500" />
        </LogoutButton>
      </div>
    </nav>
  </div>
</header>

<script>
  import { setupMenu } from '../lib/landing/menu';

  const header = document.querySelector<HTMLElement>('[data-resident-header]');
  if (header) setupMenu(header);
</script>
