---
import Layout from '../../../layouts/Layout.astro';
import AdminHeader from '../../../components/AdminHeader.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import StructureLevel from '../../../components/StructureLevel.astro';
import { listBlocks, loadPage } from '../../../lib/api/structure-server';

// HU-013. The middleware only renders /admin pages for a valid ADMINISTRADOR session.
const { csrf_token: csrfToken } = Astro.locals.auth!;
const page = await loadPage(() => listBlocks(Astro.request));
if ('unauthenticated' in page) {
  return Astro.redirect('/login');
}
if ('notFound' in page) {
  throw new Error('The blocks collection is never expected to be missing.');
}
const { items, child_label_prefix: childLabelPrefix } = page.data;
---

<Layout title="Bloques — SoftPh-Académico">
  <AdminHeader csrfToken={csrfToken} />
  <main class="mx-auto max-w-5xl space-y-6 px-4 py-8">
    <Breadcrumbs items={[{ label: 'Bloques' }]} />
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">Bloques</h1>
      <p class="mt-1 text-slate-600">
        Unidades residenciales de la Urbanización San Joaquín: Bloque → Torre → Apartamento. Elige un bloque para
        gestionar sus torres.
      </p>
    </div>
    <StructureLevel
      level="block"
      items={items.map((block) => ({ ...block, href: `/admin/blocks/${block.id}` }))}
      collectionPath="/blocks"
      itemBasePath="/blocks"
      childLabelPrefix={childLabelPrefix}
      emptyMessage="No hay bloques registrados."
      csrfToken={csrfToken}
    />
  </main>
</Layout>
