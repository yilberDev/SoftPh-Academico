---
import Layout from '../../layouts/Layout.astro';
import LogoutButton from '../../components/LogoutButton.astro';

// The middleware only renders this page for a valid ADMINISTRADOR session.
const { user, csrf_token: csrfToken } = Astro.locals.auth!;
---

<Layout title="Panel principal — SoftPh-Académico">
  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
      <p class="font-semibold text-slate-900">SoftPh-Académico</p>
      <LogoutButton csrfToken={csrfToken} />
    </div>
  </header>
  <main class="mx-auto max-w-5xl px-4 py-10">
    <p class="text-sm font-medium text-emerald-700">Administrador</p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">Hola, {user.full_name}</h1>
    <p class="mt-3 text-slate-600">Iniciaste sesión en el panel principal de la Urbanización San Joaquín.</p>
  </main>
</Layout>
