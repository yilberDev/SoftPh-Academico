---
import Layout from '../../layouts/Layout.astro';
import AdminHeader from '../../components/AdminHeader.astro';

// The middleware only renders this page for a valid ADMINISTRADOR session.
const { user, csrf_token: csrfToken } = Astro.locals.auth!;
---

<Layout title="Panel principal — SoftPh-Académico">
  <AdminHeader csrfToken={csrfToken} />
  <main class="mx-auto max-w-5xl px-4 py-10">
    <p class="text-sm font-medium text-emerald-700">Administrador</p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">Hola, {user.full_name}</h1>
    <p class="mt-3 text-slate-600">Iniciaste sesión en el panel principal de la Urbanización San Joaquín.</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      <li>
        <a
          href="/admin/blocks"
          class="block rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:border-emerald-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
        >
          <span class="font-medium text-slate-900">Unidades residenciales</span>
          <span class="mt-1 block text-sm text-slate-600">Bloques, torres y apartamentos de la urbanización.</span>
        </a>
      </li>
      <li>
        <a
          href="/admin/residents/invite"
          class="block rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:border-emerald-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
        >
          <span class="font-medium text-slate-900">Invitar residente</span>
          <span class="mt-1 block text-sm text-slate-600">Registra un residente, asígnale un apartamento y envíale la invitación.</span>
        </a>
      </li>
    </ul>
  </main>
</Layout>
