---
import Layout from '../../layouts/Layout.astro';
import AdminHeader from '../../components/AdminHeader.astro';
import Icon from '../../components/landing/Icon.astro';
import { ADMIN_MODULES, UNAVAILABLE_VALUE, summaryTiles } from '../../lib/admin/dashboard';
import { loadAdminSummary } from '../../lib/api/dashboard-server';
import { CARD, FOCUS_RING } from '../../lib/landing/ui';

// The middleware only renders this page for a valid ADMINISTRADOR session.
const { user, csrf_token: csrfToken } = Astro.locals.auth!;

// Read-only numbers of existing endpoints, computed by the backend; a failed one shows as unavailable.
const tiles = summaryTiles(await loadAdminSummary(Astro.request));

const today = new Intl.DateTimeFormat('es-CO', { dateStyle: 'full', timeZone: 'America/Bogota' }).format(new Date());

const iconBox = 'flex h-11 w-11 shrink-0 items-center justify-center rounded-md';
---

<Layout title="Panel principal — SoftPh-Académico">
  <AdminHeader csrfToken={csrfToken} />
  <div class="bg-[radial-gradient(ellipse_at_top_left,var(--color-teal-50),transparent_55%)]">
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
      <!-- Bienvenida -->
      <section
        aria-labelledby="welcome-title"
        class="relative overflow-hidden rounded-lg border border-slate-200 bg-gradient-to-br from-white via-white to-teal-50/70 p-6 shadow-[0_1px_2px_0_rgba(15,23,42,0.04)] sm:p-8"
      >
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-2xl">
            <p class="inline-flex max-w-full items-center gap-2 rounded-full border border-teal-200 bg-teal-50 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-teal-800">
              <span class="h-2 w-2 shrink-0 rounded-full bg-teal-600" aria-hidden="true"></span>
              <span>Panel de administración · Urbanización San Joaquín</span>
            </p>
            <h1 id="welcome-title" class="mt-4 text-3xl font-bold tracking-tight text-balance text-slate-900 sm:text-4xl">
              Hola, {user.full_name}
            </h1>
            <p class="mt-3 text-base leading-relaxed text-slate-600 sm:text-lg">
              Iniciaste sesión en el panel principal. Desde aquí accedes a la estructura de la urbanización, los residentes,
              las obligaciones, los pagos, el feedback y los reportes financieros.
            </p>
          </div>
          <p class="inline-flex shrink-0 items-center gap-2 self-start whitespace-nowrap text-sm text-slate-600 lg:self-auto">
            <Icon name="calendar" class="h-4 w-4 shrink-0 text-teal-700" />
            <span class="inline-block first-letter:uppercase">{today}</span>
          </p>
        </div>
      </section>

      <!-- Resumen -->
      <section aria-labelledby="summary-title" class="mt-10">
        <h2 id="summary-title" class="text-xl font-semibold tracking-tight text-slate-900">Resumen</h2>
        <p class="mt-1 text-sm text-slate-600">Datos actuales del sistema. Abre cada uno para ver el detalle.</p>
        <ul class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-4" data-summary>
          {
            tiles.map((tile) => (
              <li>
                <a
                  href={tile.href}
                  data-summary-tile={tile.key}
                  class={`${CARD} flex h-full items-start gap-4 p-5 transition-colors hover:border-teal-300 motion-reduce:transition-none ${FOCUS_RING}`}
                >
                  <span
                    class:list={[
                      iconBox,
                      tile.value !== null && tile.tone === 'attention' ? 'bg-amber-50 text-amber-700' : 'bg-teal-50 text-teal-700'
                    ]}
                  >
                    <Icon name={tile.icon} />
                  </span>
                  <span class="min-w-0">
                    <span class="block text-sm font-medium text-slate-600">{tile.label}</span>
                    {tile.value === null ? (
                      <span class="mt-1 block text-base font-semibold text-slate-500" data-summary-value>
                        {UNAVAILABLE_VALUE}
                      </span>
                    ) : (
                      <span class="mt-1 block text-3xl font-semibold tracking-tight text-slate-900 tabular-nums" data-summary-value>
                        {tile.value}
                      </span>
                    )}
                    <span class="mt-1 block text-xs leading-relaxed text-slate-500" data-summary-detail>
                      {tile.detail}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Módulos -->
      <section aria-labelledby="modules-title" class="mt-12">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2 id="modules-title" class="text-xl font-semibold tracking-tight text-slate-900">Módulos de gestión</h2>
            <p class="mt-1 text-sm text-slate-600">Elige un módulo para administrar la urbanización.</p>
          </div>
          <p class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-600">
            {ADMIN_MODULES.length} módulos
          </p>
        </div>
        <ul class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-4" data-modules>
          {
            ADMIN_MODULES.map((module, index) => (
              <li
                class={`${CARD} group relative flex flex-col p-5 transition-[border-color,box-shadow] hover:border-teal-300 hover:shadow-md focus-within:border-teal-300 motion-reduce:transition-none sm:p-6`}
                data-module
              >
                <div class="flex items-start justify-between gap-3">
                  <span class={`${iconBox} bg-teal-50 text-teal-700 transition-colors group-hover:bg-teal-700 group-hover:text-white motion-reduce:transition-none`}>
                    <Icon name={module.icon} />
                  </span>
                  <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">{module.category}</span>
                </div>
                <h3 class="mt-4 text-lg font-semibold tracking-tight text-slate-900">
                  <a
                    href={module.href}
                    aria-describedby={`module-${index}-description`}
                    class={`rounded-sm after:absolute after:inset-0 after:rounded-lg after:content-[''] group-hover:text-teal-800 ${FOCUS_RING}`}
                  >
                    {module.title}
                  </a>
                </h3>
                <p id={`module-${index}-description`} class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">
                  {module.description}
                </p>
                <p class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4 text-sm font-semibold text-teal-700" aria-hidden="true">
                  {module.action}
                  <Icon
                    name="arrowRight"
                    class="h-4 w-4 transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
                  />
                </p>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
  </div>
</Layout>
