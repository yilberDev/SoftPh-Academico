---
import Layout from '../../../layouts/Layout.astro';
import AdminHeader from '../../../components/AdminHeader.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { listAvailableUnits, listPendingInvitations } from '../../../lib/api/invitations-server';
import { loadPage } from '../../../lib/api/structure-server';
import {
  DEFAULT_VALIDITY_DAYS,
  DELIVERY_LABELS,
  EMAIL_MAX_LENGTH,
  NAME_MAX_LENGTH,
  VALIDITY_MAX_DAYS,
  VALIDITY_MIN_DAYS,
  formatBogota,
  invitationOutcome,
  parseInvitationParam
} from '../../../lib/residents/invitation-form';

// HU-003 (CA-1). The middleware only renders /admin pages for a valid ADMINISTRADOR session.
const { csrf_token: csrfToken } = Astro.locals.auth!;
const page = await loadPage(async () => ({
  units: (await listAvailableUnits(Astro.request)).items,
  invitations: (await listPendingInvitations(Astro.request)).items
}));
if ('unauthenticated' in page) {
  return Astro.redirect('/login');
}
if ('notFound' in page) {
  throw new Error('The invitation endpoints are never expected to be missing.');
}
const { units, invitations } = page.data;

// Result of the last action (CA-7): only the invitation id travels in the URL.
const resultId = parseInvitationParam(Astro.url.searchParams.get('invitation'));
const result = resultId === null ? undefined : invitations.find((invitation) => invitation.id === resultId);
const outcome = result ? invitationOutcome(result, Astro.url.searchParams.get('resent') === '1') : null;

const inputClass =
  'mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/30 disabled:bg-slate-100';
const labelClass = 'block text-sm font-medium text-slate-700';
const errorClass = 'mt-1 hidden text-sm text-red-700';
const secondaryButton =
  'rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 disabled:opacity-60';
const badgeClass = {
  SENT: 'bg-emerald-50 text-emerald-800 ring-emerald-200',
  FAILED: 'bg-red-50 text-red-800 ring-red-200',
  PENDING: 'bg-amber-50 text-amber-900 ring-amber-200'
} as const;
---

<Layout title="Invitar residente — SoftPh-Académico">
  <AdminHeader csrfToken={csrfToken} />
  <main class="mx-auto max-w-5xl space-y-8 px-4 py-8" data-invite-page data-csrf-token={csrfToken}>
    <div class="space-y-2">
      <Breadcrumbs items={[{ label: 'Residentes' }, { label: 'Invitar residente' }]} />
      <h1 class="text-2xl font-semibold tracking-tight">Invitar residente</h1>
      <p class="text-slate-600">
        Registra al residente y asígnale un apartamento disponible. Recibirá un enlace en su correo para activar su
        cuenta y crear su contraseña.
      </p>
    </div>

    {
      outcome && result && (
        <div
          role="status"
          class:list={[
            'rounded-2xl border px-5 py-4',
            outcome.tone === 'success' ? 'border-emerald-200 bg-emerald-50' : 'border-amber-200 bg-amber-50'
          ]}
        >
          <p class:list={['font-medium', outcome.tone === 'success' ? 'text-emerald-900' : 'text-amber-900']}>
            {outcome.title}
          </p>
          <p class:list={['mt-1 text-sm', outcome.tone === 'success' ? 'text-emerald-800' : 'text-amber-900']}>
            {outcome.detail}
          </p>
          {outcome.canResend && (
            <button type="button" data-resend={result.id} class={`mt-3 ${secondaryButton}`}>
              Reenviar
            </button>
          )}
        </div>
      )
    }

    <div data-page-alert role="alert" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
    </div>

    <section aria-labelledby="invite-form-title" class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
      <h2 id="invite-form-title" class="text-lg font-semibold">Datos de la invitación</h2>
      {
        units.length === 0 && (
          <p class="mt-3 rounded-lg border border-dashed border-slate-300 px-4 py-3 text-sm text-slate-600">
            No hay apartamentos disponibles. Registra apartamentos en{' '}
            <a href="/admin/blocks" class="font-medium text-emerald-800 hover:underline">
              Unidades residenciales
            </a>{' '}
            o espera a que venza una invitación.
          </p>
        )
      }
      <form data-invite-form class="mt-4 grid gap-5 sm:grid-cols-2" novalidate>
        <div>
          <label for="invite-email" class={labelClass}>Correo electrónico</label>
          <input
            id="invite-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="off"
            required
            maxlength={EMAIL_MAX_LENGTH}
            class={inputClass}
          />
          <p id="invite-email-error" data-error-for="email" class={errorClass}></p>
        </div>
        <div>
          <label for="invite-full-name" class={labelClass}>Nombre completo</label>
          <input
            id="invite-full-name"
            name="full_name"
            type="text"
            autocomplete="off"
            required
            maxlength={NAME_MAX_LENGTH}
            class={inputClass}
          />
          <p id="invite-full-name-error" data-error-for="full_name" class={errorClass}></p>
        </div>
        <div>
          <label for="invite-unit" class={labelClass}>Apartamento</label>
          <select id="invite-unit" name="unit_id" required disabled={units.length === 0} class={inputClass}>
            <option value="">Selecciona un apartamento</option>
            {units.map((unit) => <option value={unit.unit_id}>{unit.label}</option>)}
          </select>
          <p id="invite-unit-error" data-error-for="unit_id" class={errorClass}></p>
        </div>
        <div>
          <label for="invite-validity" class={labelClass}>Vigencia de la invitación</label>
          <div class="mt-1 flex items-center gap-2">
            <input
              id="invite-validity"
              name="validity_days"
              type="number"
              inputmode="numeric"
              min={VALIDITY_MIN_DAYS}
              max={VALIDITY_MAX_DAYS}
              step="1"
              value={DEFAULT_VALIDITY_DAYS}
              required
              aria-describedby="invite-validity-hint"
              class="block w-24 rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/30"
            />
            <span class="text-sm text-slate-600">días</span>
          </div>
          <p id="invite-validity-hint" class="mt-1 text-sm text-slate-500">
            Entre {VALIDITY_MIN_DAYS} y {VALIDITY_MAX_DAYS} días.
          </p>
          <p id="invite-validity-error" data-error-for="validity_days" class={errorClass}></p>
        </div>
        <div class="sm:col-span-2">
          <div data-form-alert role="alert" class="mb-4 hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
          </div>
          <button
            type="submit"
            disabled={units.length === 0}
            class="w-full rounded-lg bg-emerald-700 px-4 py-2.5 font-medium text-white hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 disabled:opacity-60 sm:w-auto"
          >
            Enviar invitación
          </button>
        </div>
      </form>
    </section>

    <section aria-labelledby="pending-title" class="space-y-3">
      <h2 id="pending-title" class="text-lg font-semibold">Invitaciones pendientes</h2>
      {
        invitations.length === 0 ? (
          <p class="rounded-2xl border border-dashed border-slate-300 bg-white px-4 py-8 text-center text-slate-600">
            No hay invitaciones pendientes.
          </p>
        ) : (
          <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-sm">
              <thead class="border-b border-slate-200 bg-slate-50 text-slate-600">
                <tr>
                  <th scope="col" class="px-4 py-3 font-medium">Residente</th>
                  <th scope="col" class="px-4 py-3 font-medium">Apartamento</th>
                  <th scope="col" class="px-4 py-3 font-medium">Vence</th>
                  <th scope="col" class="px-4 py-3 font-medium">Correo</th>
                  <th scope="col" class="px-4 py-3 text-right font-medium">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {invitations.map((invitation) => (
                  <tr>
                    <th scope="row" class="px-4 py-3 font-normal">
                      <span class="block font-medium text-slate-900">{invitation.full_name}</span>
                      <span class="block break-all text-slate-600">{invitation.email}</span>
                    </th>
                    <td class="whitespace-nowrap px-4 py-3 font-mono text-slate-700">{invitation.unit.label}</td>
                    <td class="px-4 py-3 text-slate-700">{formatBogota(invitation.expires_at)}</td>
                    <td class="px-4 py-3">
                      <span
                        class:list={[
                          'inline-flex rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset',
                          badgeClass[invitation.delivery_status]
                        ]}
                      >
                        {DELIVERY_LABELS[invitation.delivery_status]}
                      </span>
                      <span class="mt-1 block text-xs text-slate-500">
                        {invitation.send_attempts} {invitation.send_attempts === 1 ? 'intento' : 'intentos'}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-right">
                      <button
                        type="button"
                        data-resend={invitation.id}
                        class={secondaryButton}
                        aria-label={`Reenviar la invitación de ${invitation.email}`}
                      >
                        Reenviar
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
      <p class="text-sm text-slate-500">
        Reenviar genera un enlace nuevo (el anterior deja de funcionar) y no amplía la vigencia.
      </p>
    </section>
  </main>
</Layout>

<script>
  import { ApiError } from '../../../lib/api/errors';
  import { createInvitation, resendInvitation } from '../../../lib/api/invitations';
  import {
    resultPath,
    validateInvitationForm,
    type FieldErrors,
    type InvitationField
  } from '../../../lib/residents/invitation-form';

  const CONNECTION_ERROR = 'No fue posible conectar con el servidor. Intenta de nuevo.';
  const FIELDS: InvitationField[] = ['email', 'full_name', 'unit_id', 'validity_days'];

  const page = document.querySelector<HTMLElement>('[data-invite-page]')!;
  const csrfToken = page.dataset.csrfToken ?? '';
  const form = page.querySelector<HTMLFormElement>('[data-invite-form]')!;
  const formAlert = form.querySelector<HTMLElement>('[data-form-alert]')!;
  const pageAlert = page.querySelector<HTMLElement>('[data-page-alert]')!;
  const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

  function show(element: HTMLElement, message: string | null): void {
    element.textContent = message ?? '';
    element.classList.toggle('hidden', !message);
  }

  function showFieldErrors(errors: FieldErrors): void {
    let first: HTMLElement | null = null;
    for (const field of FIELDS) {
      const control = form.elements.namedItem(field) as HTMLInputElement | HTMLSelectElement;
      const error = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`)!;
      const message = errors[field] ?? null;
      show(error, message);
      control.setAttribute('aria-invalid', message ? 'true' : 'false');
      if (message) {
        control.setAttribute('aria-describedby', error.id);
        first ??= control;
      } else if (field !== 'validity_days') {
        control.removeAttribute('aria-describedby');
      } else {
        control.setAttribute('aria-describedby', 'invite-validity-hint');
      }
    }
    first?.focus();
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    show(formAlert, null);
    const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement).value;
    const { errors, payload } = validateInvitationForm({
      email: value('email'),
      fullName: value('full_name'),
      unitId: value('unit_id'),
      validityDays: value('validity_days')
    });
    showFieldErrors(errors);
    if (!payload) {
      return;
    }
    submit.disabled = true;
    try {
      const invitation = await createInvitation(payload, csrfToken);
      window.location.assign(resultPath(invitation.id));
    } catch (error) {
      submit.disabled = false;
      if (!(error instanceof ApiError)) {
        show(formAlert, CONNECTION_ERROR);
        return;
      }
      const fieldErrors: FieldErrors = {};
      for (const detail of error.details) {
        if (detail.field && (FIELDS as string[]).includes(detail.field)) {
          fieldErrors[detail.field as InvitationField] ??= detail.message;
        }
      }
      if (Object.keys(fieldErrors).length > 0) {
        showFieldErrors(fieldErrors);
      } else {
        // 409: apartment no longer available, email already registered or with a pending invitation.
        show(formAlert, error.message);
      }
    }
  });

  page.querySelectorAll<HTMLButtonElement>('[data-resend]').forEach((button) => {
    button.addEventListener('click', async () => {
      show(pageAlert, null);
      button.disabled = true;
      const invitationId = Number(button.dataset.resend);
      try {
        await resendInvitation(invitationId, csrfToken);
        window.location.assign(resultPath(invitationId, true));
      } catch (error) {
        button.disabled = false;
        show(pageAlert, error instanceof ApiError ? error.message : CONNECTION_ERROR);
        pageAlert.scrollIntoView({ block: 'nearest' });
      }
    });
  });
</script>
