---
import Layout from '../../../layouts/Layout.astro';
import AdminHeader from '../../../components/AdminHeader.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { loadResident } from '../../../lib/api/residents-server';
import { isValidId, loadPage } from '../../../lib/api/structure-server';
import { NAME_MAX_LENGTH } from '../../../lib/residents/invitation-form';
import {
  DOCUMENT_MAX_LENGTH,
  LIST_PATH,
  PHONE_MAX_LENGTH,
  accountStatementPath
} from '../../../lib/residents/resident-detail';

// HU-015. The middleware only renders /admin pages for a valid ADMINISTRADOR session; the API
// decides which fields are exposed and authorizes every change on its own (HU-018).
const { csrf_token: csrfToken } = Astro.locals.auth!;
const { id } = Astro.params;
const page = isValidId(id) ? await loadPage(() => loadResident(id, Astro.request)) : { notFound: true as const };
if ('unauthenticated' in page) {
  return Astro.redirect('/login');
}
const resident = 'data' in page ? page.data : null;
if (!resident) {
  Astro.response.status = 404;
}
// Initial state for the page script (personal data: the page is never cached, see the middleware).
const initialJson = resident ? JSON.stringify(resident).replace(/</g, '\\u003c') : '';

const inputClass =
  'mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/30 disabled:bg-slate-100 aria-[invalid=true]:border-red-500';
const labelClass = 'block text-sm font-medium text-slate-700';
const primaryButton =
  'rounded-lg bg-emerald-700 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 disabled:opacity-60';
const secondaryButton =
  'rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 disabled:opacity-60';
const dangerButton =
  'rounded-lg bg-red-700 px-4 py-2 text-sm font-medium text-white hover:bg-red-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600 disabled:opacity-60';
const card = 'rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6';
---

<Layout title={resident ? `${resident.full_name} — Residentes — SoftPh-Académico` : 'Residente no encontrado — SoftPh-Académico'}>
  <AdminHeader csrfToken={csrfToken} />
  <main class="mx-auto max-w-3xl space-y-6 px-4 py-8" data-resident-page data-csrf-token={csrfToken}>
    <Breadcrumbs items={[{ label: 'Residentes', href: LIST_PATH }, { label: resident ? resident.full_name : 'No encontrado' }]} />
    {
      !resident ? (
        <div class="rounded-2xl border border-slate-200 bg-white px-6 py-10 text-center shadow-sm">
          <p class="text-slate-700">Este residente no existe o ya no está registrado.</p>
          <a href={LIST_PATH} class="mt-4 inline-block rounded text-sm font-medium text-emerald-800 hover:underline">Volver a residentes</a>
        </div>
      ) : (
        <>
          <script type="application/json" data-initial set:html={initialJson} />
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h1 data-title class="text-2xl font-semibold tracking-tight break-words">{resident.full_name}</h1>
              <p class="mt-1 text-sm text-slate-600">Residente registrado</p>
            </div>
            <span data-status-badge class="inline-flex rounded-full px-3 py-1 text-sm font-medium ring-1 ring-inset"></span>
          </div>

          <div data-notice role="status" aria-live="polite" class="hidden rounded-lg border px-4 py-3 text-sm">
            <p data-notice-text></p>
            <a data-notice-list href={LIST_PATH} class="mt-2 hidden font-medium underline">Ir al listado de residentes</a>
          </div>

          <section aria-labelledby="data-title" class={card}>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 id="data-title" class="text-lg font-semibold">Información del residente</h2>
              <div class="flex flex-wrap gap-2" data-actions>
                <a href={accountStatementPath(resident.id)} class={secondaryButton}>Estado de cuenta</a>
                <button type="button" data-edit class={secondaryButton}>Editar datos</button>
                <button type="button" data-delete class={dangerButton}>Eliminar residente</button>
              </div>
            </div>
            <dl class="mt-4 grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
              <div><dt class="text-slate-500">Nombre completo</dt><dd data-show="full_name" class="font-medium text-slate-900 break-words"></dd></div>
              <div><dt class="text-slate-500">Número de documento</dt><dd data-show="document_number" class="font-mono text-slate-900"></dd></div>
              <div><dt class="text-slate-500">Teléfono</dt><dd data-show="phone" class="text-slate-900"></dd></div>
              <div><dt class="text-slate-500">Correo electrónico</dt><dd data-show="email" class="break-all text-slate-900"></dd></div>
              <div><dt class="text-slate-500">Unidad residencial</dt><dd data-show="unit" class="font-mono text-slate-900"></dd></div>
              <div><dt class="text-slate-500">Estado de la cuenta</dt><dd data-show="status" class="text-slate-900"></dd></div>
            </dl>
            <p class="mt-4 text-xs text-slate-500">
              El correo electrónico (con el que el residente inicia sesión), el estado de la cuenta y la unidad residencial no se
              modifican desde aquí.
            </p>
          </section>

          <section aria-labelledby="edit-title" data-edit-section class:list={[card, 'hidden']}>
            <h2 id="edit-title" class="text-lg font-semibold">Editar datos del residente</h2>
            <form data-edit-form class="mt-4 space-y-4" novalidate>
              <div>
                <label for="resident-full-name" class={labelClass}>Nombre completo</label>
                <input id="resident-full-name" name="full_name" type="text" autocomplete="off" maxlength={NAME_MAX_LENGTH} required class={inputClass} />
                <p id="resident-full-name-error" data-error-for="full_name" class="mt-1 hidden text-sm text-red-700"></p>
              </div>
              <div>
                <label for="resident-document" class={labelClass}>Número de documento</label>
                <input id="resident-document" name="document_number" type="text" autocomplete="off" maxlength={DOCUMENT_MAX_LENGTH} required class={inputClass} />
                <p id="resident-document-error" data-error-for="document_number" class="mt-1 hidden text-sm text-red-700"></p>
              </div>
              <div>
                <label for="resident-phone" class={labelClass}>Teléfono <span class="font-normal text-slate-500">(opcional)</span></label>
                <input id="resident-phone" name="phone" type="tel" autocomplete="off" maxlength={PHONE_MAX_LENGTH} class={inputClass} />
                <p id="resident-phone-error" data-error-for="phone" class="mt-1 hidden text-sm text-red-700"></p>
              </div>
              <div class="flex flex-wrap gap-2 pt-2">
                <button type="submit" data-save class={primaryButton}>Guardar cambios</button>
                <button type="button" data-cancel-edit class={secondaryButton}>Cancelar</button>
              </div>
            </form>
          </section>

          <dialog data-confirm-dialog aria-labelledby="confirm-title" aria-describedby="confirm-text"
            class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl p-0 shadow-xl backdrop:bg-slate-900/40">
            <div class="space-y-3 p-6">
              <h2 id="confirm-title" class="text-lg font-semibold">¿Eliminar a este residente?</h2>
              <p id="confirm-text" class="text-sm text-slate-600">
                <span data-confirm-name class="font-medium text-slate-900"></span> dejará de figurar en el listado de residentes
                registrados, su residencia en <span data-confirm-unit class="font-mono"></span> terminará y no podrá volver a
                iniciar sesión. Sus pagos y su historial se conservan.
              </p>
              <p class="text-sm text-slate-600">
                No se puede eliminar mientras su unidad residencial tenga saldo pendiente, saldo a favor o un pago de
                demostración en curso. Su correo electrónico queda reservado y no podrá usarse en una nueva invitación.
              </p>
              <div class="flex justify-end gap-2 pt-2">
                <button type="button" data-confirm-cancel class={secondaryButton}>Cancelar</button>
                <button type="button" data-confirm-ok class={dangerButton}>Eliminar residente</button>
              </div>
            </div>
          </dialog>
        </>
      )
    }
  </main>
</Layout>

<script>
  import { deleteResident, getResident, updateResident, type ResidentDetail } from '../../../lib/api/residents';
  import {
    createResidentDetail,
    type ResidentDetailState,
    type ResidentField
  } from '../../../lib/residents/resident-detail';
  import { STATUS_LABELS } from '../../../lib/residents/residents-list';

  const page = document.querySelector<HTMLElement>('[data-resident-page]')!;
  const initialScript = page.querySelector<HTMLScriptElement>('[data-initial]');
  if (initialScript) {
    const csrfToken = page.dataset.csrfToken ?? '';
    const $ = <T extends Element>(selector: string) => page.querySelector<T>(selector)!;
    const show = (element: Element, visible: boolean) => element.classList.toggle('hidden', !visible);
    const notice = $<HTMLElement>('[data-notice]');
    const editSection = $<HTMLElement>('[data-edit-section]');
    const form = $<HTMLFormElement>('[data-edit-form]');
    const inputs: Record<ResidentField, HTMLInputElement> = {
      full_name: $('#resident-full-name'),
      document_number: $('#resident-document'),
      phone: $('#resident-phone')
    };
    const editButton = $<HTMLButtonElement>('[data-edit]');
    const deleteButton = $<HTMLButtonElement>('[data-delete]');
    const saveButton = $<HTMLButtonElement>('[data-save]');
    const cancelEditButton = $<HTMLButtonElement>('[data-cancel-edit]');
    const dialog = $<HTMLDialogElement>('[data-confirm-dialog]');
    const okButton = $<HTMLButtonElement>('[data-confirm-ok]');
    const cancelDeleteButton = $<HTMLButtonElement>('[data-confirm-cancel]');
    let wasEditing = false;

    const TONES = {
      success: 'border-emerald-200 bg-emerald-50 text-emerald-900',
      info: 'border-slate-200 bg-slate-50 text-slate-800',
      warning: 'border-amber-200 bg-amber-50 text-amber-900',
      error: 'border-red-200 bg-red-50 text-red-800'
    } as const;
    const BADGE = {
      ACTIVE: 'bg-emerald-50 text-emerald-800 ring-emerald-200',
      INACTIVE: 'bg-slate-100 text-slate-700 ring-slate-300'
    } as const;

    function renderData(resident: ResidentDetail): void {
      $('[data-title]').textContent = resident.full_name;
      $('[data-show="full_name"]').textContent = resident.full_name;
      $('[data-show="document_number"]').textContent = resident.document_number ?? '—';
      $('[data-show="phone"]').textContent = resident.phone ?? 'Sin teléfono';
      $('[data-show="email"]').textContent = resident.email;
      $('[data-show="unit"]').textContent = resident.unit.label;
      $('[data-show="status"]').textContent = STATUS_LABELS[resident.status];
      const badge = $<HTMLElement>('[data-status-badge]');
      badge.textContent = STATUS_LABELS[resident.status];
      badge.className = `inline-flex rounded-full px-3 py-1 text-sm font-medium ring-1 ring-inset ${BADGE[resident.status]}`;
      $('[data-confirm-name]').textContent = resident.full_name;
      $('[data-confirm-unit]').textContent = resident.unit.label;
    }

    function renderErrors(state: ResidentDetailState): void {
      let first: HTMLInputElement | null = null;
      for (const [field, input] of Object.entries(inputs) as [ResidentField, HTMLInputElement][]) {
        const message = state.errors[field];
        const error = $<HTMLElement>(`[data-error-for="${field}"]`);
        error.textContent = message ?? '';
        show(error, Boolean(message));
        input.setAttribute('aria-invalid', message ? 'true' : 'false');
        if (message) {
          input.setAttribute('aria-describedby', error.id);
          first ??= input;
        } else {
          input.removeAttribute('aria-describedby');
        }
      }
      first?.focus();
    }

    function render(state: ResidentDetailState): void {
      renderData(state.resident);
      const busy = state.busy !== null;
      show(editSection, state.editing);
      if (state.editing && !wasEditing) {
        // The form opens with the stored data.
        inputs.full_name.value = state.values.fullName;
        inputs.document_number.value = state.values.documentNumber;
        inputs.phone.value = state.values.phone;
        inputs.full_name.focus();
      }
      wasEditing = state.editing;
      for (const input of Object.values(inputs)) input.disabled = busy;
      saveButton.disabled = busy;
      cancelEditButton.disabled = busy;
      saveButton.textContent = state.busy === 'save' ? 'Guardando…' : 'Guardar cambios';
      editButton.disabled = busy || state.gone || state.editing;
      deleteButton.disabled = busy || state.gone || state.editing;
      show($('[data-actions]'), !state.gone);
      okButton.disabled = busy;
      cancelDeleteButton.disabled = busy;
      okButton.textContent = state.busy === 'delete' ? 'Eliminando…' : 'Eliminar residente';
      if (state.confirmingDelete && !dialog.open) dialog.showModal();
      if (!state.confirmingDelete && dialog.open) dialog.close();
      renderErrors(state);
      show(notice, state.notice !== null);
      if (state.notice) {
        notice.className = `rounded-lg border px-4 py-3 text-sm ${TONES[state.notice.tone]}`;
        $('[data-notice-text]').textContent = state.notice.text;
      }
      show($('[data-notice-list]'), state.gone || state.notice?.tone === 'success');
    }

    const initial = JSON.parse(initialScript.textContent ?? '{}') as ResidentDetail;
    const detail = createResidentDetail(initial, {
      update: (id, payload) => updateResident(id, payload, csrfToken),
      remove: (id, updatedAt) => deleteResident(id, updatedAt, csrfToken),
      reload: getResident,
      render,
      navigate: (path) => window.location.assign(path)
    });
    render(detail.state);

    editButton.addEventListener('click', () => detail.startEdit());
    cancelEditButton.addEventListener('click', () => detail.cancelEdit());
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      void detail.save({
        fullName: inputs.full_name.value,
        documentNumber: inputs.document_number.value,
        phone: inputs.phone.value
      });
    });
    deleteButton.addEventListener('click', () => detail.askDelete());
    cancelDeleteButton.addEventListener('click', () => detail.cancelDelete());
    dialog.addEventListener('cancel', (event) => {
      // Escape: the same as "Cancelar" (nothing is sent), unless the deletion is on its way.
      event.preventDefault();
      detail.cancelDelete();
    });
    okButton.addEventListener('click', () => void detail.confirmDelete());
  }
</script>
