---
import Layout from '../../../layouts/Layout.astro';
import AdminHeader from '../../../components/AdminHeader.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { LOADING_MESSAGE, PAGE_SIZES, SEARCH_MAX_LENGTH, parseQuery } from '../../../lib/feedback/feedback-list';

// HU-005. The middleware only renders /admin pages for a valid ADMINISTRADOR
// session; the API authorizes every request on its own (HU-018).
const { csrf_token: csrfToken } = Astro.locals.auth!;
const initial = parseQuery(Astro.url.searchParams);

const columns = [
  { field: 'resident', label: 'Residente' },
  { field: 'subject', label: 'Asunto' },
  { field: 'created_at', label: 'Fecha' },
  { field: 'status', label: 'Estado' }
] as const;

const inputClass =
  'mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/30';
const labelClass = 'block text-sm font-medium text-slate-700';
const secondaryButton =
  'rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 disabled:cursor-not-allowed disabled:opacity-50';
---

<Layout title="Feedback — SoftPh-Académico">
  <AdminHeader csrfToken={csrfToken} />
  <main class="mx-auto max-w-5xl space-y-6 px-4 py-8" data-feedback-page>
    <div class="space-y-2">
      <Breadcrumbs items={[{ label: 'Feedback' }]} />
      <h1 class="text-2xl font-semibold tracking-tight">Feedback</h1>
      <p class="text-slate-600">Quejas, solicitudes y sugerencias de los residentes de la Urbanización San Joaquín.</p>
    </div>

    <form data-filters role="search" class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-[1fr_12rem]">
      <div>
        <label for="feedback-search" class={labelClass}>Buscar residente o asunto</label>
        <input id="feedback-search" type="search" autocomplete="off" maxlength={SEARCH_MAX_LENGTH} value={initial.search}
          placeholder="Ej.: Laura o ruido" class={inputClass} />
      </div>
      <div>
        <label for="feedback-status" class={labelClass}>Estado</label>
        <select id="feedback-status" class={inputClass}>
          <option value="" selected={initial.status === ''}>Todos</option>
          <option value="PENDING" selected={initial.status === 'PENDING'}>Pendientes</option>
          <option value="RESOLVED" selected={initial.status === 'RESOLVED'}>Resueltos</option>
        </select>
      </div>
    </form>

    <div data-alert role="alert" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <p data-alert-message></p>
      <button type="button" data-retry class={`mt-3 ${secondaryButton}`}>Reintentar</button>
    </div>

    <section aria-labelledby="feedback-table-title" class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <h2 id="feedback-table-title" class="sr-only">Listado de feedback</h2>
      <p data-status-line class="border-b border-slate-200 px-4 py-3 text-sm text-slate-600" aria-live="polite">{LOADING_MESSAGE}</p>
      <!-- relative: the visually hidden header text is positioned (and clipped) inside the scroll area. -->
      <div class="relative overflow-x-auto">
        <table class="w-full min-w-[44rem] divide-y divide-slate-200 text-left text-sm" data-table aria-busy="true">
          <thead class="bg-slate-50 text-slate-700">
            <tr>
              {
                columns.map(({ field, label }) => (
                  <th scope="col" class="whitespace-nowrap px-4 py-2 font-medium" data-sort-header={field} aria-sort="none">
                    <button type="button" data-sort={field}
                      class="inline-flex items-center gap-1 rounded hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600">
                      {label}
                      <span data-sort-icon aria-hidden="true" class="text-slate-400">↕</span>
                    </button>
                  </th>
                ))
              }
              <th scope="col" class="px-4 py-2 font-medium"><span class="sr-only">Acción</span></th>
            </tr>
          </thead>
          <tbody data-rows class="divide-y divide-slate-100"></tbody>
        </table>
      </div>
      <p data-message class="hidden px-4 py-10 text-center text-slate-600"></p>
      <div data-loading class="space-y-3 px-4 py-6" aria-hidden="true">
        <div class="h-4 w-3/4 animate-pulse rounded bg-slate-100"></div>
        <div class="h-4 w-2/3 animate-pulse rounded bg-slate-100"></div>
        <div class="h-4 w-1/2 animate-pulse rounded bg-slate-100"></div>
      </div>
      <nav data-pagination aria-label="Paginación del feedback"
        class="hidden flex-wrap items-center justify-between gap-3 border-t border-slate-200 px-4 py-3 text-sm">
        <div class="flex items-center gap-2">
          <label for="feedback-page-size" class="text-slate-600">Por página</label>
          <select id="feedback-page-size" data-page-size class="rounded-lg border border-slate-300 bg-white px-2 py-1">
            {PAGE_SIZES.map((size) => <option value={size} selected={initial.pageSize === size}>{size}</option>)}
          </select>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" data-page="prev" class={secondaryButton}>Anterior</button>
          <span data-page-info class="whitespace-nowrap text-slate-600"></span>
          <button type="button" data-page="next" class={secondaryButton}>Siguiente</button>
        </div>
      </nav>
    </section>
  </main>
</Layout>

<script>
  import { listFeedback, type FeedbackListItem, type FeedbackSortField, type FeedbackStatus } from '../../../lib/api/feedback';
  import { formatDateTime } from '../../../lib/feedback/feedback-detail';
  import {
    EMPTY_MESSAGE,
    LOADING_MESSAGE,
    NO_RESULTS_MESSAGE,
    NO_SUBJECT,
    STATUS_LABELS,
    createFeedbackList,
    parseQuery,
    rangeText,
    type FeedbackListState
  } from '../../../lib/feedback/feedback-list';

  const page = document.querySelector<HTMLElement>('[data-feedback-page]')!;
  const $ = <T extends Element>(selector: string) => page.querySelector<T>(selector)!;
  const show = (element: Element, visible: boolean) => element.classList.toggle('hidden', !visible);
  const table = $<HTMLTableElement>('[data-table]');
  const rows = $<HTMLElement>('[data-rows]');
  const statusLine = $<HTMLElement>('[data-status-line]');
  const message = $<HTMLElement>('[data-message]');
  const loading = $<HTMLElement>('[data-loading]');
  const alert = $<HTMLElement>('[data-alert]');
  const pagination = $<HTMLElement>('[data-pagination]');
  const pageInfo = $<HTMLElement>('[data-page-info]');
  const prev = $<HTMLButtonElement>('[data-page="prev"]');
  const next = $<HTMLButtonElement>('[data-page="next"]');
  const pageSize = $<HTMLSelectElement>('[data-page-size]');
  const searchInput = $<HTMLInputElement>('#feedback-search');
  const statusSelect = $<HTMLSelectElement>('#feedback-status');

  const BADGE = {
    PENDING: 'bg-amber-50 text-amber-900 ring-amber-200',
    RESOLVED: 'bg-emerald-50 text-emerald-800 ring-emerald-200'
  } as const;

  function cell(content: string | Node, className: string): HTMLTableCellElement {
    const element = document.createElement('td');
    element.className = className;
    element.append(content);
    return element;
  }

  function row(item: FeedbackListItem): HTMLTableRowElement {
    const tr = document.createElement('tr');
    const name = document.createElement('th');
    name.scope = 'row';
    name.className = 'min-w-[11rem] px-4 py-3 font-medium text-slate-900';
    name.textContent = item.resident.full_name;
    const subject = document.createElement('span');
    subject.textContent = item.subject ?? NO_SUBJECT;
    if (!item.subject) subject.className = 'italic text-slate-500';
    const badge = document.createElement('span');
    badge.className = `inline-flex whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${BADGE[item.status]}`;
    badge.textContent = STATUS_LABELS[item.status];
    const link = document.createElement('a');
    link.href = `/admin/feedback/${item.id}`;
    link.className = 'whitespace-nowrap rounded font-medium text-emerald-800 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600';
    link.textContent = 'Ver detalle';
    link.setAttribute('aria-label', `Ver detalle del feedback de ${item.resident.full_name}`);
    tr.append(
      name,
      cell(subject, 'min-w-[12rem] px-4 py-3 text-slate-700'),
      cell(formatDateTime(item.created_at), 'whitespace-nowrap px-4 py-3 text-slate-700'),
      cell(badge, 'px-4 py-3'),
      cell(link, 'px-4 py-3 text-right')
    );
    return tr;
  }

  function render(state: FeedbackListState): void {
    const { query } = state;
    page.querySelectorAll<HTMLElement>('[data-sort-header]').forEach((header) => {
      const active = header.dataset.sortHeader === query.sortBy;
      header.setAttribute('aria-sort', active ? (query.sortOrder === 'asc' ? 'ascending' : 'descending') : 'none');
      header.querySelector('[data-sort-icon]')!.textContent = active ? (query.sortOrder === 'asc' ? '↑' : '↓') : '↕';
    });
    table.setAttribute('aria-busy', String(state.kind === 'loading'));
    show(loading, state.kind === 'loading');
    show(alert, state.kind === 'error');
    show(message, state.kind === 'empty' || state.kind === 'no-results');
    pagination.classList.toggle('hidden', state.kind !== 'results');
    pagination.classList.toggle('flex', state.kind === 'results');
    if (state.kind !== 'results') rows.replaceChildren();
    switch (state.kind) {
      case 'loading':
        statusLine.textContent = LOADING_MESSAGE;
        break;
      case 'results':
        rows.replaceChildren(...state.page.items.map(row));
        statusLine.textContent = rangeText(state.page);
        pageInfo.textContent = `Página ${state.page.page} de ${state.page.total_pages}`;
        prev.disabled = state.page.page <= 1;
        next.disabled = state.page.page >= state.page.total_pages;
        pageSize.value = String(state.page.page_size);
        break;
      case 'empty':
      case 'no-results':
        statusLine.textContent = '0 registros';
        message.textContent = state.kind === 'empty' ? EMPTY_MESSAGE : NO_RESULTS_MESSAGE;
        break;
      case 'error':
        statusLine.textContent = 'No se pudo cargar el listado.';
        $('[data-alert-message]').textContent = state.message;
        break;
    }
  }

  const list = createFeedbackList(parseQuery(new URLSearchParams(window.location.search)), {
    load: listFeedback,
    render,
    remember: (queryString) =>
      history.replaceState(null, '', queryString ? `${window.location.pathname}?${queryString}` : window.location.pathname),
    navigate: (path) => window.location.assign(path)
  });

  $('[data-filters]').addEventListener('submit', (event) => event.preventDefault());
  searchInput.addEventListener('input', () => list.search(searchInput.value));
  statusSelect.addEventListener('change', () => list.filter(statusSelect.value as FeedbackStatus | ''));
  page.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((button) => {
    button.addEventListener('click', () => list.sort(button.dataset.sort as FeedbackSortField));
  });
  prev.addEventListener('click', () => list.goToPage(list.query.page - 1));
  next.addEventListener('click', () => list.goToPage(list.query.page + 1));
  pageSize.addEventListener('change', () => list.setPageSize(Number(pageSize.value)));
  $('[data-retry]').addEventListener('click', () => list.refresh());
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') void list.refresh();
  });
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) void list.refresh();
  });

  void list.start();
</script>
