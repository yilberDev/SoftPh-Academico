---
// The public landing page of SoftPh. No session is needed (the middleware treats "/" as public and does not
// even ask for one). It only describes what SoftPh already does; the dashboard and the table are
// illustrative. Access goes through the real login page (/login), which sends a signed-in user to the home
// page of their role.
import Layout from '../layouts/Layout.astro';
import ButtonLink from '../components/landing/ButtonLink.astro';
import DashboardPreview from '../components/landing/DashboardPreview.astro';
import FinancialPreview from '../components/landing/FinancialPreview.astro';
import Icon from '../components/landing/Icon.astro';
import SectionHeader from '../components/landing/SectionHeader.astro';
import SiteFooter from '../components/landing/SiteFooter.astro';
import SiteHeader from '../components/landing/SiteHeader.astro';
import {
  FEATURES,
  FINANCE_POINTS,
  HERO_POINTS,
  LOGIN_PATH,
  PRIVACY_NOTE,
  ROLES,
  SECTIONS,
  STEPS,
  VALUE_POINTS
} from '../lib/landing/content';
import { CARD, FOCUS_RING, ICON_BOX } from '../lib/landing/ui';

const container = 'mx-auto max-w-7xl px-4 sm:px-6 lg:px-8';
const section = 'py-16 sm:py-20 lg:py-24';
---

<Layout
  title="SoftPh — Gestión de propiedad horizontal"
  description="SoftPh simplifica la administración de la propiedad horizontal en Colombia: residentes, pagos, estados de cuenta, solicitudes y notificaciones desde una plataforma centralizada."
>
  <a href="#contenido" class={`sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-teal-800 focus:shadow ${FOCUS_RING}`}>
    Saltar al contenido
  </a>
  <SiteHeader />

  <main id="contenido" class="bg-slate-50">
    <!-- Hero -->
    <section id={SECTIONS.home} aria-labelledby="hero-title" class="scroll-mt-16 overflow-hidden">
      <div class={`${container} grid items-center gap-12 pb-16 pt-12 sm:pt-16 lg:grid-cols-12 lg:gap-10 lg:pb-20 lg:pt-20`}>
        <div class="max-w-xl lg:col-span-6 xl:col-span-5">
          <p class="inline-flex items-center gap-2 rounded-full bg-teal-100/70 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-teal-800 ring-1 ring-inset ring-teal-700/15">
            <span class="h-1.5 w-1.5 rounded-full bg-teal-700" aria-hidden="true"></span>
            Gestión de propiedad horizontal
          </p>
          <h1 id="hero-title" class="mt-6 text-[2.125rem] font-bold leading-[2.625rem] tracking-tight text-slate-900 sm:text-5xl sm:leading-[3.5rem] lg:text-[2.5rem] lg:leading-[3.125rem] xl:text-5xl xl:leading-[3.5rem]">
            Tu comunidad,{' '}<br class="hidden sm:inline" /><span class="text-teal-800">mejor administrada.</span>
          </h1>
          <p class="mt-5 text-base leading-7 text-slate-600 sm:text-lg sm:leading-8">
            Simplifica la administración de tu propiedad horizontal en Colombia. Organiza residentes, pagos, estados de
            cuenta y solicitudes desde una plataforma centralizada.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <ButtonLink href={LOGIN_PATH} size="lg">
              Ingresar a SoftPh
              <Icon name="arrowRight" class="h-[1.125rem] w-[1.125rem]" />
            </ButtonLink>
            <ButtonLink href={`#${SECTIONS.features}`} variant="secondary" size="lg">Conocer funcionalidades</ButtonLink>
          </div>
          <div class="mt-8 flex items-start gap-2.5 border-t border-slate-200 pt-6 text-sm text-slate-600">
            <Icon name="shieldCheck" class="mt-0.5 h-[1.125rem] w-[1.125rem] shrink-0 text-teal-700" />
            <ul class="flex flex-wrap gap-x-2 gap-y-1">
              {
                HERO_POINTS.map((point, index) => (
                  // The separator travels with the point before it, so a wrapped line never starts with it.
                  <li class="flex items-center gap-2">
                    {point}
                    {index < HERO_POINTS.length - 1 && <span class="text-slate-400" aria-hidden="true">·</span>}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <div class="min-w-0 lg:col-span-6 xl:col-span-7">
          <DashboardPreview />
        </div>
      </div>
    </section>

    <!-- Value proposition -->
    <section aria-label="Propuesta de valor" class="border-y border-slate-200 bg-white shadow-[0_1px_2px_0_rgba(15,23,42,0.04)]">
      <ul class={`${container} grid gap-8 py-10 md:grid-cols-3 md:gap-10 lg:gap-12`}>
        {
          VALUE_POINTS.map(({ icon, title, text }) => (
            <li class="flex items-start gap-4 md:flex-col lg:flex-row">
              <span class={`${ICON_BOX} h-12 w-12`}><Icon name={icon} class="h-6 w-6" /></span>
              <div>
                <p class="text-base font-semibold tracking-tight text-slate-900 sm:text-lg">{title}</p>
                <p class="mt-1 text-sm leading-6 text-slate-600">{text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Features -->
    <section id={SECTIONS.features} aria-labelledby="features-title" class={`scroll-mt-16 ${section}`}>
      <div class={container}>
        <SectionHeader
          id="features-title"
          align="start"
          eyebrow="Funcionalidades"
          title="Todo lo que necesitas para gestionar tu comunidad"
          intro="Herramientas para la administración y para los residentes, cada uno con su propio acceso."
        />
        <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            FEATURES.map(({ icon, title, text, audience }) => (
              <li class={`${CARD} flex flex-col p-6 transition-shadow hover:shadow-[0_4px_6px_-1px_rgba(15,23,42,0.07),0_2px_4px_-2px_rgba(15,23,42,0.04)] motion-reduce:transition-none`}>
                <span class={`${ICON_BOX} h-10 w-10`}><Icon name={icon} class="h-[1.375rem] w-[1.375rem]" /></span>
                <h3 class="mt-5 text-lg font-semibold tracking-tight text-slate-900">{title}</h3>
                <p class="mt-2 flex-1 text-sm leading-6 text-slate-600">{text}</p>
                <p class="mt-6 flex items-center justify-between gap-3 rounded-md bg-slate-50 px-3 py-2.5 text-xs ring-1 ring-inset ring-slate-200/70">
                  <span class="text-slate-600">Disponible para</span>
                  <span class="text-right font-semibold text-teal-800">{audience}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Financial information -->
    <section aria-labelledby="finance-title" class={`border-y border-slate-200 bg-slate-100/70 ${section}`}>
      <div class={container}>
        <SectionHeader
          id="finance-title"
          eyebrow="Información financiera"
          title="Información clara para tomar mejores decisiones"
          intro="Cada pago se aplica a las obligaciones pendientes de la unidad, y los saldos se calculan a partir de los pagos y las obligaciones registrados."
        />
        <ul class="mx-auto mt-8 flex w-fit max-w-full flex-col gap-3">
          {
            FINANCE_POINTS.map((item) => (
              <li class="flex gap-2.5 text-sm font-medium text-slate-700">
                <Icon name="checkCircle" class="h-5 w-5 shrink-0 text-teal-700" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-10">
          <FinancialPreview />
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id={SECTIONS.howItWorks} aria-labelledby="steps-title" class={`scroll-mt-16 ${section}`}>
      <div class={container}>
        <SectionHeader
          id="steps-title"
          eyebrow="Cómo funciona"
          title="Proceso simple y transparente para tu conjunto"
          intro="Tres pasos para pasar de la información dispersa a una administración ordenada."
        />
        <ol class="mt-12 grid gap-6 lg:grid-cols-3 lg:gap-8">
          {
            STEPS.map(({ number, icon, title, text, outcome }) => (
              <li class={`${CARD} flex flex-col p-6 sm:p-8 md:flex-row md:gap-8 lg:flex-col lg:gap-0`}>
                <span class="text-[2.75rem] font-extrabold leading-none tracking-tight text-slate-300" aria-hidden="true">{number}</span>
                <div class="flex flex-1 flex-col">
                  <h3 class="mt-6 text-lg font-semibold tracking-tight text-slate-900 md:mt-1 lg:mt-6">{title}</h3>
                  <p class="mt-3 flex-1 text-sm leading-6 text-slate-600">{text}</p>
                  <p class="mt-8 flex items-center gap-2 text-sm font-semibold text-teal-800 md:mt-5 lg:mt-8">
                    <Icon name={icon} class="h-[1.125rem] w-[1.125rem] shrink-0" />
                    {outcome}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Roles -->
    <section id={SECTIONS.benefits} aria-labelledby="roles-title" class={`scroll-mt-16 border-t border-slate-200 bg-slate-100/70 ${section}`}>
      <div class={container}>
        <SectionHeader
          id="roles-title"
          eyebrow="Beneficios"
          title="Una experiencia pensada para cada rol"
          intro="Cada rol tiene su propio acceso y ve solo lo que necesita."
        />
        <div class="mt-12 grid gap-6 lg:grid-cols-2 lg:gap-8">
          {
            ROLES.map(({ icon, badge, title, text, items, area }, index) => (
              <article class:list={[CARD, 'flex flex-col overflow-hidden border-t-4', index === 0 ? 'border-t-teal-700' : 'border-t-slate-400']}>
                <div class="flex-1 p-6 sm:p-8">
                  <div class="flex items-center justify-between gap-4">
                    <span class:list={['inline-flex items-center gap-1.5 rounded px-2.5 py-1 text-xs font-semibold',
                      index === 0 ? 'bg-teal-50 text-teal-800' : 'bg-slate-100 text-slate-700']}>
                      <span class:list={['h-1.5 w-1.5 rounded-full', index === 0 ? 'bg-teal-700' : 'bg-slate-500']} aria-hidden="true"></span>
                      {badge}
                    </span>
                    <Icon name={icon} class={index === 0 ? 'h-7 w-7 text-teal-700' : 'h-7 w-7 text-slate-500'} />
                  </div>
                  <h3 class="mt-6 text-2xl font-bold tracking-tight text-slate-900">{title}</h3>
                  <p class="mt-2 text-sm leading-6 text-slate-600">{text}</p>
                  <ul class="mt-6 space-y-3.5">
                    {items.map((item) => (
                      <li class="flex items-start gap-3 text-sm text-slate-800">
                        <Icon name="checkCircle" class={index === 0 ? 'h-5 w-5 shrink-0 text-teal-700' : 'h-5 w-5 shrink-0 text-slate-500'} />
                        <span class="pt-px">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <p class="flex flex-col gap-1 border-t border-slate-200 bg-slate-50 px-6 py-4 text-xs sm:flex-row sm:items-center sm:justify-between sm:gap-3 sm:px-8">
                  <span class="font-semibold text-slate-900">{area}</span>
                  <span class="font-medium text-slate-600">Cada usuario accede con su propia cuenta</span>
                </p>
              </article>
            ))
          }
        </div>
        <p class={`${CARD} mt-8 flex items-start justify-center gap-3 px-4 py-4 text-sm text-slate-600 sm:items-center sm:text-center`}>
          <Icon name="lock" class="h-5 w-5 shrink-0 text-teal-700" />
          <span><strong class="font-semibold text-slate-900">Privacidad:</strong> {PRIVACY_NOTE}</span>
        </p>
      </div>
    </section>

    <!-- Final call to action -->
    <section aria-labelledby="cta-title" class="bg-teal-700 px-4 py-16 text-white sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
        <p class="rounded-full bg-teal-800 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-teal-50">SoftPh</p>
        <h2 id="cta-title" class="mt-5 text-[1.75rem] font-bold leading-9 tracking-tight sm:text-[2.5rem] sm:leading-[3rem]">
          Una gestión más organizada empieza aquí.
        </h2>
        <p class="mt-4 max-w-2xl text-base leading-7 text-teal-50 sm:text-lg sm:leading-8">
          Accede a SoftPh y consulta las herramientas disponibles para administrar tu comunidad.
        </p>
        <div class="mt-8 flex w-full flex-col items-stretch justify-center gap-3 sm:w-auto sm:flex-row sm:items-center sm:gap-4">
          <ButtonLink href={LOGIN_PATH} variant="inverse" size="lg">
            Ingresar a SoftPh
            <Icon name="logIn" class="h-[1.125rem] w-[1.125rem]" />
          </ButtonLink>
          <ButtonLink href={`#${SECTIONS.howItWorks}`} variant="onDark" size="lg">Ver cómo funciona</ButtonLink>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
