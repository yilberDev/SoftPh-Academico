---
import Layout from '../layouts/Layout.astro';
import ApiStatus from '../components/ApiStatus.astro';
import { getHealth, type HealthStatus } from '../lib/api/health';

let health: HealthStatus | null = null;
try {
  health = await getHealth(Astro.request);
} catch {
  health = null;
}
---

<Layout title="SoftPh-Académico">
  <main class="mx-auto flex min-h-screen max-w-xl flex-col justify-center px-4 py-12">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <p class="text-sm font-medium text-emerald-700">Urbanización San Joaquín</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">SoftPh-Académico está funcionando</h1>
      <p class="mt-3 text-slate-600">
        Infraestructura inicial del prototipo académico de gestión de propiedad horizontal.
      </p>
      <div class="mt-6 border-t border-slate-100 pt-6">
        <h2 class="mb-3 text-sm font-semibold text-slate-700">Estado de los servicios</h2>
        <ApiStatus health={health} />
      </div>
    </div>
  </main>
</Layout>
