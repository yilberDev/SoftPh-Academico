---
import Layout from '../layouts/Layout.astro';

// HU-016: request a password reset link (residents). The answer is always the
// same message, so this page never reveals whether an email is registered.
Astro.response.headers.set('Cache-Control', 'no-store');

const inputClass =
  'mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/30';
---

<Layout title="Recuperar contraseña — SoftPh-Académico">
  <main class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-4 py-12">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8" data-forgot>
      <p class="text-sm font-medium text-emerald-700">Urbanización San Joaquín</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight">Recuperar contraseña</h1>

      <form data-forgot-form class="mt-6 space-y-5" novalidate>
        <p class="text-sm text-slate-600">
          Ingresa el correo electrónico de tu cuenta de residente y te enviaremos un enlace para crear una contraseña
          nueva.
        </p>
        <div data-alert role="alert" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"></div>
        <div>
          <label for="email" class="block text-sm font-medium text-slate-700">Correo electrónico</label>
          <input id="email" name="email" type="email" autocomplete="username" required maxlength="254" class={inputClass} />
          <p id="email-error" class="mt-1 hidden text-sm text-red-700"></p>
        </div>
        <button
          type="submit"
          class="w-full rounded-lg bg-emerald-700 px-4 py-2.5 font-medium text-white hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 disabled:opacity-60"
        >
          Enviar enlace
        </button>
      </form>

      <div data-received role="status" aria-live="polite" class="mt-6 hidden rounded-xl border border-emerald-200 bg-emerald-50 p-4">
        <p class="font-semibold text-emerald-900">Revisa tu correo</p>
        <p data-received-message class="mt-1 text-sm text-emerald-900"></p>
      </div>

      <p class="mt-6 text-center text-sm">
        <a
          href="/login"
          class="rounded font-medium text-emerald-800 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
        >
          Volver a iniciar sesión
        </a>
      </p>
    </div>
  </main>
</Layout>

<script>
  import { requestPasswordReset } from '../lib/api/password-reset';
  import { createForgotFlow, type ForgotState } from '../lib/auth/password-reset';

  const root = document.querySelector<HTMLElement>('[data-forgot]')!;
  const form = root.querySelector<HTMLFormElement>('[data-forgot-form]')!;
  const input = form.querySelector<HTMLInputElement>('#email')!;
  const fieldError = form.querySelector<HTMLElement>('#email-error')!;
  const alertBox = form.querySelector<HTMLElement>('[data-alert]')!;
  const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const received = root.querySelector<HTMLElement>('[data-received]')!;

  function show(element: HTMLElement, message: string | null): void {
    element.textContent = message ?? '';
    element.classList.toggle('hidden', !message);
  }

  function render(state: ForgotState): void {
    const sending = state.kind === 'sending';
    submit.disabled = sending;
    submit.textContent = sending ? 'Enviando…' : 'Enviar enlace';
    const error = state.kind === 'idle' ? state.error : null;
    show(fieldError, error);
    input.setAttribute('aria-invalid', error ? 'true' : 'false');
    if (error) {
      input.setAttribute('aria-describedby', fieldError.id);
      input.focus();
    } else {
      input.removeAttribute('aria-describedby');
    }
    show(alertBox, state.kind === 'error' ? state.message : null);
    if (state.kind === 'received') {
      form.classList.add('hidden');
      root.querySelector<HTMLElement>('[data-received-message]')!.textContent = state.message;
      received.classList.remove('hidden');
    }
  }

  const flow = createForgotFlow({ request: requestPasswordReset, render });
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    void flow.submit(input.value);
  });
</script>
