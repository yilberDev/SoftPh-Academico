---
import Layout from '../layouts/Layout.astro';

// Entry point of password recovery (HU-007 criterion 3 / HU-002 criterion 3).
// The recovery process (request, token, email, new password) is HU-016 and is
// not implemented yet: this page sends nothing and stores nothing.
Astro.response.headers.set('Cache-Control', 'no-store');
---

<Layout title="Recuperar contraseña — SoftPh-Académico">
  <main class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-4 py-12">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <p class="text-sm font-medium text-emerald-700">Urbanización San Joaquín</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight">Recuperar contraseña</h1>
      <p class="mt-4 text-slate-600">
        La recuperación de contraseña en línea estará disponible próximamente. Mientras tanto, si no puedes ingresar,
        comunícate con la administración de la urbanización.
      </p>
      <a
        href="/login"
        class="mt-6 inline-block rounded font-medium text-emerald-800 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
      >
        Volver a iniciar sesión
      </a>
    </div>
  </main>
</Layout>
