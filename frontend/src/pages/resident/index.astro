---
import Layout from '../../layouts/Layout.astro';
import ResidentHeader from '../../components/ResidentHeader.astro';
import { demoPaymentsEnabled } from '../../lib/resident/demo-payment-flag-server';

// HU-007: main panel of the resident. The middleware only renders /resident
// pages for a valid RESIDENTE session. The resident functions are added by
// their own HUs (HU-008: "Mis pagos"; HU-009: "Enviar feedback", "Mis feedback"; HU-010: the demo
// payment, only while DEMO_PAYMENTS_ENABLED).
const { user, csrf_token: csrfToken } = Astro.locals.auth!;
const demoPayments = demoPaymentsEnabled();

const cardLink =
  'block h-full rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:border-emerald-300 hover:bg-emerald-50/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600';
---

<Layout title="Panel del residente — SoftPh-Académico">
  <ResidentHeader csrfToken={csrfToken} />
  <main class="mx-auto max-w-5xl px-4 py-10">
    <p class="text-sm font-medium text-emerald-700">Residente</p>
    <h1 class="mt-1 break-words text-2xl font-semibold tracking-tight sm:text-3xl">Hola, {user.full_name}</h1>
    <p class="mt-3 text-slate-600">Iniciaste sesión en el panel de residentes de la Urbanización San Joaquín.</p>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      <li>
        <a href="/resident/account-statement" class={cardLink}>
          <span class="block font-semibold text-slate-900">Estado de cuenta</span>
          <span class="mt-1 block text-sm text-slate-600">Consulta las obligaciones de tu unidad residencial, tus pagos, el total pendiente y el estado de tu cuenta.</span>
        </a>
      </li>
      <li>
        <a href="/resident/payments" class={cardLink}>
          <span class="block font-semibold text-slate-900">Mis pagos</span>
          <span class="mt-1 block text-sm text-slate-600">Consulta los pagos registrados en tu cuenta, su estado y su detalle.</span>
        </a>
      </li>
      {
        demoPayments && (
          <li>
            <a href="/resident/demo-payments" class={cardLink}>
              <span class="block font-semibold text-slate-900">Pago de demostración</span>
              <span class="mt-1 block text-sm text-slate-600">
                Simula el pago de una obligación pendiente con la pasarela interna. Sin dinero real ni proveedores externos.
              </span>
            </a>
          </li>
        )
      }
      <li>
        <div class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="font-semibold text-slate-900">Feedback</h2>
          <p class="mt-1 text-sm text-slate-600">Comparte una queja, sugerencia o solicitud con la administración y consulta su estado.</p>
          <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-3">
            <a href="/resident/feedback/new"
              class="rounded-lg bg-emerald-700 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600">
              Enviar feedback
            </a>
            <a href="/resident/feedback"
              class="rounded text-sm font-medium text-emerald-800 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600">
              Mis feedback
            </a>
          </div>
        </div>
      </li>
    </ul>
    <p class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-white px-4 py-6 text-sm text-slate-600">
      Aquí encontrarás tus solicitudes a medida que estén disponibles.
    </p>
  </main>
</Layout>
