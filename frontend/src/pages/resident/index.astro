---
import Layout from '../../layouts/Layout.astro';
import LogoutButton from '../../components/LogoutButton.astro';

// HU-007: main panel of the resident. The middleware only renders /resident
// pages for a valid RESIDENTE session. The resident functions (account
// statement, payments, feedback) are added by their own HUs.
const { user, csrf_token: csrfToken } = Astro.locals.auth!;
---

<Layout title="Panel del residente — SoftPh-Académico">
  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
      <p class="font-semibold text-slate-900">SoftPh-Académico</p>
      <LogoutButton csrfToken={csrfToken} />
    </div>
  </header>
  <main class="mx-auto max-w-5xl px-4 py-10">
    <p class="text-sm font-medium text-emerald-700">Residente</p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">Hola, {user.full_name}</h1>
    <p class="mt-3 text-slate-600">Iniciaste sesión en el panel de residentes de la Urbanización San Joaquín.</p>
    <p class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-white px-4 py-6 text-sm text-slate-600">
      Aquí encontrarás tu estado de cuenta, tus pagos y tus solicitudes a medida que estén disponibles.
    </p>
  </main>
</Layout>
