---
import Layout from '../../layouts/Layout.astro';
import ResidentHeader from '../../components/ResidentHeader.astro';

// HU-007: main panel of the resident. The middleware only renders /resident
// pages for a valid RESIDENTE session. The resident functions are added by
// their own HUs (HU-008: "Mis pagos").
const { user, csrf_token: csrfToken } = Astro.locals.auth!;
---

<Layout title="Panel del residente — SoftPh-Académico">
  <ResidentHeader csrfToken={csrfToken} />
  <main class="mx-auto max-w-5xl px-4 py-10">
    <p class="text-sm font-medium text-emerald-700">Residente</p>
    <h1 class="mt-1 break-words text-2xl font-semibold tracking-tight sm:text-3xl">Hola, {user.full_name}</h1>
    <p class="mt-3 text-slate-600">Iniciaste sesión en el panel de residentes de la Urbanización San Joaquín.</p>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      <li>
        <a
          href="/resident/payments"
          class="block h-full rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:border-emerald-300 hover:bg-emerald-50/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
        >
          <span class="block font-semibold text-slate-900">Mis pagos</span>
          <span class="mt-1 block text-sm text-slate-600">Consulta los pagos registrados en tu cuenta, su estado y su detalle.</span>
        </a>
      </li>
    </ul>
    <p class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-white px-4 py-6 text-sm text-slate-600">
      Aquí encontrarás tu estado de cuenta y tus solicitudes a medida que estén disponibles.
    </p>
  </main>
</Layout>
