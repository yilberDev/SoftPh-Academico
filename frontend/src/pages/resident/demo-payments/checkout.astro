---
import Layout from '../../../layouts/Layout.astro';
import ResidentHeader from '../../../components/ResidentHeader.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { demoPaymentsEnabled } from '../../../lib/resident/demo-payment-flag-server';
import {
  DEMO_NOTICE,
  DEMO_NOTICE_TITLE,
  DEMO_PAYMENTS_PATH,
  HISTORY_PATH,
  SIMULATION_BADGE,
  UNAVAILABLE_TEXT,
  UNAVAILABLE_TITLE,
  parseTransactionParam
} from '../../../lib/resident/demo-payment';
import {
  APPROVAL_EFFECT,
  CHECKOUT_LOADING,
  CHECKOUT_STEPS,
  DEMO_RECEIPT_LINK,
  INSTRUMENTS_HINT,
  INSTRUMENTS_LOADING,
  INSTRUMENTS_TITLE,
  MISSING_TEXT,
  MISSING_TITLE,
  NOT_LISTED_NOTE,
  PROCESSING_HINT,
  PROCESSING_MESSAGE,
  PROCESS_LABEL,
  RETRY_LABEL,
  SELECT_FIRST,
  TRANSACTION_MISSING,
  UNCERTAIN_TEXT
} from '../../../lib/resident/demo-checkout';

// HU-010-D, the checkout of one demo transaction (/resident/demo-payments/checkout?transaction=<id>): the
// obligations page starts it and opens this one; a reload reads it again from the server. Same rules as
// the obligations page: the middleware only renders /resident pages for a valid RESIDENTE session, the API
// decides everything and checks Origin and CSRF on every POST, and DEMO_PAYMENTS_ENABLED off hides the
// page (404, no controls, no request). Without a valid ?transaction= nothing is requested either.
const { csrf_token: csrfToken } = Astro.locals.auth!;
const enabled = demoPaymentsEnabled();
if (!enabled) {
  Astro.response.status = 404;
}
const transactionId = parseTransactionParam(Astro.url.search);
const active = enabled && transactionId !== null;

const card = 'rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6';
const primaryButton =
  'rounded-lg bg-emerald-700 px-4 py-2 font-medium text-white hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 disabled:cursor-not-allowed disabled:opacity-60';
const secondaryButton =
  'rounded-lg border border-slate-300 bg-white px-4 py-2 font-medium text-slate-700 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 disabled:cursor-not-allowed disabled:opacity-60';
const dangerButton =
  'rounded-lg border border-red-300 bg-white px-4 py-2 font-medium text-red-800 hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600 disabled:cursor-not-allowed disabled:opacity-60';
const link =
  'rounded text-sm font-medium text-emerald-800 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600';
const heading = 'text-lg font-semibold focus:outline-none';
const centered = 'rounded-2xl border border-slate-200 bg-white px-6 py-10 text-center shadow-sm';
---

<Layout title="Pago de la transacción de demostración — SoftPh-Académico">
  <ResidentHeader csrfToken={csrfToken} />
  <main class="mx-auto max-w-3xl space-y-6 px-4 py-8" data-demo-checkout-page={active ? '' : undefined}
    data-csrf-token={active ? csrfToken : undefined}>
    <div class="space-y-3">
      <Breadcrumbs items={[
        { label: 'Inicio', href: '/resident' },
        { label: 'Pago de demostración', href: DEMO_PAYMENTS_PATH },
        { label: 'Pago de la transacción' }
      ]} />
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold tracking-tight">Pago de demostración</h1>
        <p class="inline-flex items-center gap-2 rounded-full bg-amber-100 px-3 py-1 text-sm font-medium text-amber-950 ring-1 ring-inset ring-amber-300">
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 shrink-0">
            <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a1 1 0 0 0 0 2v3a1 1 0 0 0 1 1h1a1 1 0 1 0 0-2v-3a1 1 0 0 0-1-1H9Z" clip-rule="evenodd" />
          </svg>
          {SIMULATION_BADGE}
        </p>
      </div>
    </div>

    <ol data-steps aria-label="Pasos del pago de demostración" class="hidden grid-cols-2 gap-2 text-sm sm:grid-cols-4">
      {
        CHECKOUT_STEPS.map((label, index) => (
          <li data-step-item={index} class="flex min-w-0 items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-slate-500">
            <span data-step-mark aria-hidden="true"
              class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xs font-semibold text-slate-600">
              {index + 1}
            </span>
            <span class="min-w-0 break-words">{label}</span>
            <span data-step-state class="sr-only"></span>
          </li>
        ))
      }
    </ol>

    <!-- Always visible: what this is, and what it is not. -->
    <div role="note" aria-labelledby="demo-notice-title" class="rounded-2xl border border-amber-300 bg-amber-50 px-4 py-4 sm:px-5">
      <p id="demo-notice-title" class="font-semibold text-amber-950">{DEMO_NOTICE_TITLE}</p>
      <p class="mt-1 text-sm text-amber-950">{DEMO_NOTICE}</p>
    </div>

    {
      !enabled ? (
        <div class={centered}>
          <h2 class="text-xl font-semibold tracking-tight">{UNAVAILABLE_TITLE}</h2>
          <p class="mt-2 text-sm text-slate-600">{UNAVAILABLE_TEXT}</p>
          <div class="mt-5 flex flex-wrap justify-center gap-4">
            <a href={HISTORY_PATH} class={link}>Ir a Mis pagos</a>
            <a href="/resident" class={link}>Volver al inicio</a>
          </div>
        </div>
      ) : !active ? (
        <div class={centered}>
          <h2 class="text-xl font-semibold tracking-tight">{MISSING_TITLE}</h2>
          <p class="mt-2 text-sm text-slate-600">{MISSING_TEXT}</p>
          <a href={DEMO_PAYMENTS_PATH} class:list={['mt-5 inline-block', link]}>Volver a mis obligaciones</a>
        </div>
      ) : (
        <>
          <div data-error role="alert" tabindex="-1"
            class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 focus:outline-none">
            <p data-error-message></p>
            <a data-login href="/login" class:list={['mt-2 hidden', link]}>Iniciar sesión</a>
          </div>
          <p data-info role="status" class="hidden rounded-lg border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900"></p>

          <section data-section="loading" class={card} aria-busy="true">
            <p class="text-sm text-slate-600" role="status">{CHECKOUT_LOADING}</p>
            <div class="mt-4 space-y-3" aria-hidden="true">
              <div class="h-4 w-3/4 animate-pulse rounded bg-slate-100"></div>
              <div class="h-4 w-1/2 animate-pulse rounded bg-slate-100"></div>
            </div>
          </section>

          <section data-section="unavailable" class:list={['hidden', centered]}>
            <h2 data-focus tabindex="-1" class="text-xl font-semibold tracking-tight focus:outline-none">{UNAVAILABLE_TITLE}</h2>
            <p class="mt-2 text-sm text-slate-600">{UNAVAILABLE_TEXT}</p>
            <a href={HISTORY_PATH} class:list={['mt-5 inline-block', link]}>Ir a Mis pagos</a>
          </section>

          <section data-section="not-found" class:list={['hidden', centered]}>
            <h2 data-focus tabindex="-1" class="text-xl font-semibold tracking-tight focus:outline-none">{TRANSACTION_MISSING}</h2>
            <a href={DEMO_PAYMENTS_PATH} class:list={['mt-5 inline-block', link]}>Volver a mis obligaciones</a>
          </section>

          <section data-section="load-error" class:list={['hidden', centered]}>
            <h2 data-focus tabindex="-1" data-load-error-message class="text-lg font-semibold focus:outline-none"></h2>
            <div class="mt-5 flex flex-wrap justify-center gap-4">
              <button type="button" data-retry class={secondaryButton}>Reintentar</button>
              <a data-load-login href="/login" class:list={['hidden self-center', link]}>Iniciar sesión</a>
              <a href={DEMO_PAYMENTS_PATH} class:list={['self-center', link]}>Volver a mis obligaciones</a>
            </div>
          </section>

          <div data-section="transaction" class="hidden space-y-6">
            <!-- The summary: what the server keeps of the transaction (and the obligation while it is listed). -->
            <section class={card} aria-labelledby="demo-summary-title">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0">
                  <h2 id="demo-summary-title" class="text-sm font-medium text-slate-500">Resumen del pago</h2>
                  <p data-summary-concept class="mt-1 break-words text-lg font-semibold text-slate-900"></p>
                  <p data-summary-amount class="mt-1 text-3xl font-semibold tracking-tight text-slate-900"></p>
                </div>
                <p>
                  <span class="sr-only">Estado: </span>
                  <span data-transaction-badge class="inline-flex whitespace-nowrap rounded-full px-3 py-1 text-sm font-medium ring-1 ring-inset"></span>
                </p>
              </div>
              <dl data-transaction-lines class="mt-4 grid gap-x-6 gap-y-2 border-t border-slate-200 pt-4 text-sm sm:grid-cols-2"></dl>
              <p data-not-listed class="mt-4 hidden text-sm text-slate-600">{NOT_LISTED_NOTE}</p>
            </section>

            <!-- Step: choose the instrument -->
            <section data-step="select" class:list={['hidden', card]} aria-labelledby="demo-select-title">
              <h2 id="demo-select-title" data-focus tabindex="-1" data-select-title class={heading}></h2>
              <p data-select-text class="mt-1 text-sm text-slate-600"></p>
              <!-- The backend's fictitious test instruments (radio buttons built from its answer): never a card or bank field. -->
              <fieldset data-instruments-fieldset aria-describedby="demo-instruments-hint" class="mt-5 min-w-0 space-y-3">
                <legend class="font-medium text-slate-900">{INSTRUMENTS_TITLE}</legend>
                <p id="demo-instruments-hint" class="text-sm text-slate-600">{INSTRUMENTS_HINT}</p>
                <p data-instruments-loading role="status" class="text-sm text-slate-600">{INSTRUMENTS_LOADING}</p>
                <div data-instruments-error class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
                  <p data-instruments-error-message></p>
                  <button type="button" data-instruments-retry class:list={['mt-2', secondaryButton]}>Reintentar</button>
                </div>
                <ul data-instruments class="grid gap-3"></ul>
              </fieldset>
              <p class="mt-4 text-sm text-slate-600">{APPROVAL_EFFECT}</p>
              <div class="mt-5 flex flex-wrap items-center gap-3 border-t border-slate-200 pt-5">
                <button type="button" data-process aria-describedby="demo-process-hint" class={primaryButton}>{PROCESS_LABEL}</button>
                <button type="button" data-cancel class={dangerButton}>Cancelar operación</button>
                <button type="button" data-check class={secondaryButton}>Consultar estado</button>
              </div>
              <p id="demo-process-hint" data-process-hint class="mt-3 text-sm text-slate-600" aria-live="polite">{SELECT_FIRST}</p>
              <p data-polling class="mt-1 text-xs text-slate-500" aria-live="polite"></p>
            </section>

            <!-- Step: processing (its own view, announced) -->
            <section data-step="processing" class:list={['hidden', card]} aria-labelledby="demo-processing-title">
              <div role="status" aria-live="polite" class="flex items-start gap-4">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="mt-0.5 h-6 w-6 shrink-0 animate-spin text-emerald-700">
                  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" class="opacity-25" />
                  <path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                </svg>
                <div class="min-w-0">
                  <h2 id="demo-processing-title" data-focus tabindex="-1" class={heading}>{PROCESSING_MESSAGE}</h2>
                  <p data-processing-instrument class="mt-1 text-sm text-slate-700"></p>
                  <p class="mt-1 text-sm text-slate-600">{PROCESSING_HINT}</p>
                </div>
              </div>
            </section>

            <!-- Step: no answer, and the reading of the state failed too: only "Consultar estado" -->
            <section data-step="uncertain" class:list={['hidden', card]} aria-labelledby="demo-uncertain-title">
              <h2 id="demo-uncertain-title" data-focus tabindex="-1" class={heading}>{UNCERTAIN_TEXT.title}</h2>
              <p class="mt-2 text-sm text-slate-700">{UNCERTAIN_TEXT.text}</p>
              <button type="button" data-check class:list={['mt-5', primaryButton]}>Consultar estado</button>
            </section>

            <!-- Step: the result the server answered -->
            <section data-step="result" class:list={['hidden', card]} aria-labelledby="demo-result-title">
              <h2 id="demo-result-title" data-focus tabindex="-1" data-result-title class={heading}></h2>
              <p data-result-text class="mt-2 text-slate-700"></p>
              <p data-result-reason class="mt-3 hidden rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700"></p>
              <div data-retry-box class="mt-5 hidden border-t border-slate-200 pt-5">
                <button type="button" data-retry-another aria-describedby="demo-retry-hint" class={primaryButton}>{RETRY_LABEL}</button>
                <p id="demo-retry-hint" data-retry-hint class="mt-2 text-sm text-slate-600"></p>
              </div>
              <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-slate-200 pt-5">
                <a data-payment-link href={HISTORY_PATH} class:list={['hidden', link]}>Ver el pago en Mis pagos</a>
                <a data-receipt-link href={HISTORY_PATH} download class:list={['hidden', link]}>{DEMO_RECEIPT_LINK}</a>
                <a data-history-link href={HISTORY_PATH} class:list={['hidden', link]}>Ir a Mis pagos</a>
                <a href={DEMO_PAYMENTS_PATH} class={link}>Volver a mis obligaciones</a>
              </div>
            </section>
          </div>

          <dialog data-cancel-dialog aria-labelledby="cancel-title" aria-describedby="cancel-text"
            class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl p-0 shadow-xl backdrop:bg-slate-900/40">
            <div class="space-y-3 p-6">
              <h2 id="cancel-title" class="text-lg font-semibold">¿Cancelar la operación?</h2>
              <p id="cancel-text" class="text-sm text-slate-600">
                No se aplicará ningún pago y esta transacción no podrá retomarse. Podrás iniciar un nuevo pago de demostración.
              </p>
              <div class="flex flex-wrap justify-end gap-2 pt-2">
                <button type="button" data-cancel-keep class={secondaryButton}>Seguir con la operación</button>
                <button type="button" data-cancel-ok class={dangerButton}>Cancelar operación</button>
              </div>
            </div>
          </dialog>
        </>
      )
    }
  </main>
</Layout>

<script>
  import {
    cancelDemoPayment,
    completeDemoPayment,
    getDemoPayment,
    listDemoInstruments,
    listPayableObligations,
    startDemoPayment,
    type DemoInstrument
  } from '../../../lib/api/demo-payments';
  import { obligationTitle, paymentPath, parseTransactionParam } from '../../../lib/resident/demo-payment';
  import {
    INSTRUMENTS_EMPTY,
    PROCESS_LABEL,
    SELECT_FIRST,
    TRANSACTION_STATUS_BADGES,
    TRANSACTION_STATUS_LABELS,
    canCancel,
    canChooseInstrument,
    canProcess,
    canRetryWithAnother,
    checkoutStep,
    createDemoCheckoutFlow,
    instrumentDetails,
    isRetryable,
    parseResumedParam,
    receiptLinkOf,
    resultReasonText,
    retryHint,
    stepIndex,
    transactionHeading,
    transactionLines,
    type CheckoutState
  } from '../../../lib/resident/demo-checkout';
  import { formatCop } from '../../../lib/resident/payment-format';

  const page = document.querySelector<HTMLElement>('[data-demo-checkout-page]');
  if (page) setUp(page); // disabled, or no transaction in the URL: nothing runs, nothing is requested

  function setUp(page: HTMLElement): void {
    const $ = <T extends Element>(selector: string) => page.querySelector<T>(selector)!;
    const $$ = <T extends Element>(selector: string) => [...page.querySelectorAll<T>(selector)];
    const show = (element: Element, visible: boolean) => element.classList.toggle('hidden', !visible);
    const csrfToken = page.dataset.csrfToken ?? '';

    const errorBox = $<HTMLElement>('[data-error]');
    const info = $<HTMLElement>('[data-info]');
    const dialog = $<HTMLDialogElement>('[data-cancel-dialog]');
    const steps = $<HTMLOListElement>('[data-steps]');

    function lines(target: HTMLElement, items: { label: string; value: string; mono?: boolean }[]): void {
      target.replaceChildren(
        ...items.map(({ label, value, mono }) => {
          const row = document.createElement('div');
          const term = document.createElement('dt');
          term.className = 'text-slate-500';
          term.textContent = label;
          const description = document.createElement('dd');
          description.className = mono ? 'break-all font-mono font-medium text-slate-900' : 'font-medium text-slate-900';
          description.textContent = value;
          row.append(term, description);
          return row;
        })
      );
    }

    /**
     * One option per instrument, in the server's order: a radio button named by the instrument's label and
     * described by its details. Built once per catalog (re-rendering would lose the keyboard focus).
     */
    function instrumentItem(instrument: DemoInstrument, index: number): HTMLLIElement {
      const item = document.createElement('li');
      item.className = 'relative flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-4 has-[:checked]:border-emerald-600 has-[:checked]:bg-emerald-50 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-emerald-600/40 has-[:disabled]:opacity-70';
      const input = document.createElement('input');
      input.type = 'radio';
      input.name = 'demo-instrument';
      input.id = `demo-instrument-${index}`;
      input.value = instrument.id;
      input.className = 'relative z-10 mt-1 h-4 w-4 shrink-0 accent-emerald-700 focus:outline-none'; // above the label's card-wide area
      input.setAttribute('aria-describedby', `demo-instrument-${index}-details`);
      const text = document.createElement('div');
      text.className = 'min-w-0';
      const label = document.createElement('label');
      label.htmlFor = input.id;
      // The whole card selects the option.
      label.className = 'block cursor-pointer break-words font-medium text-slate-900 after:absolute after:inset-0';
      label.textContent = instrument.label;
      const details = document.createElement('div');
      details.id = `demo-instrument-${index}-details`;
      details.className = 'mt-1 space-y-0.5 text-sm text-slate-600';
      for (const line of instrumentDetails(instrument)) {
        const paragraph = document.createElement('p');
        paragraph.textContent = line;
        details.append(paragraph);
      }
      text.append(label, details);
      item.append(input, text);
      return item;
    }

    function renderSteps(current: number | null): void {
      show(steps, current !== null);
      steps.classList.toggle('grid', current !== null);
      for (const item of $$<HTMLLIElement>('[data-step-item]')) {
        const index = Number(item.dataset.stepItem);
        const done = current !== null && index < current;
        const now = index === current;
        if (now) item.setAttribute('aria-current', 'step');
        else item.removeAttribute('aria-current');
        item.className = `flex min-w-0 items-center gap-2 rounded-lg border px-3 py-2 ${now ? 'border-emerald-600 bg-emerald-50 font-medium text-emerald-900' : done ? 'border-slate-200 bg-white text-slate-700' : 'border-slate-200 bg-white text-slate-500'}`;
        const mark = item.querySelector<HTMLElement>('[data-step-mark]')!;
        mark.textContent = done ? '✓' : String(index + 1);
        mark.className = `inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold ${now ? 'bg-emerald-700 text-white' : done ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600'}`;
        item.querySelector('[data-step-state]')!.textContent = now ? ' (paso actual)' : done ? ' (completado)' : '';
      }
    }

    let shown = '';
    let notified: CheckoutState['notice'] = null;
    let catalogShown: DemoInstrument[] | null = null;

    function render(state: CheckoutState): void {
      const { view } = state;
      const busy = state.busy !== null;
      const step = checkoutStep(state);
      for (const section of $$<HTMLElement>('[data-section]')) show(section, section.dataset.section === view.kind);
      renderSteps(step === null ? null : stepIndex(step));

      // Notices: errors in the alert, information in the status line.
      const error = state.notice?.tone === 'error' ? state.notice.text : '';
      $('[data-error-message]').textContent = error;
      show(errorBox, Boolean(error));
      show($('[data-login]'), state.sessionExpired && view.kind !== 'load-error');
      info.textContent = state.notice?.tone === 'info' ? state.notice.text : '';
      show(info, state.notice?.tone === 'info');

      if (view.kind === 'load-error') {
        $('[data-load-error-message]').textContent = view.message;
        show($('[data-retry]'), !state.sessionExpired);
        show($('[data-load-login]'), state.sessionExpired);
      }

      if (view.kind === 'transaction') {
        const { transaction } = view;
        for (const panel of $$<HTMLElement>('[data-step]')) show(panel, panel.dataset.step === step);

        // The summary: the obligation's concept only while the server lists it.
        $('[data-summary-concept]').textContent = state.obligation ? obligationTitle(state.obligation) : 'Pago de demostración';
        $('[data-summary-amount]').textContent = formatCop(transaction.amount);
        const badge = $<HTMLElement>('[data-transaction-badge]');
        badge.className = `inline-flex whitespace-nowrap rounded-full px-3 py-1 text-sm font-medium ring-1 ring-inset ${TRANSACTION_STATUS_BADGES[transaction.status]}`;
        badge.textContent = step === 'processing' ? 'Procesando' : TRANSACTION_STATUS_LABELS[transaction.status];
        lines($('[data-transaction-lines]'), transactionLines(transaction, state.obligation, state.catalog.items));
        show($('[data-not-listed]'), state.listed === false && transaction.status !== 'INITIATED');

        const { title, text } = transactionHeading(transaction);
        if (step === 'select') {
          $('[data-select-title]').textContent = title;
          $('[data-select-text]').textContent = text;
        }

        // The instruments, as the server listed them; the choice is the controller's.
        const { catalog } = state;
        show($('[data-instruments-loading]'), catalog.status === 'idle' || catalog.status === 'loading');
        show($('[data-instruments-error]'), catalog.status === 'error');
        $('[data-instruments-error-message]').textContent = catalog.error ?? '';
        const list = $<HTMLUListElement>('[data-instruments]');
        const items = catalog.status === 'ready' ? catalog.items : null;
        if (items !== catalogShown) {
          catalogShown = items;
          list.replaceChildren(...(items ?? []).map(instrumentItem));
        }
        const choosable = canChooseInstrument(state);
        for (const input of $$<HTMLInputElement>('input[name="demo-instrument"]')) {
          input.checked = input.value === state.selectedInstrument;
          input.disabled = !choosable;
        }
        const chosen = catalog.items.find((instrument) => instrument.id === state.selectedInstrument);
        $('[data-process-hint]').textContent = catalog.status === 'ready' && catalog.items.length === 0 ? INSTRUMENTS_EMPTY
          : chosen ? `Se procesará con «${chosen.label}». El resultado lo confirma el servidor.` : SELECT_FIRST;
        $<HTMLButtonElement>('[data-process]').textContent = PROCESS_LABEL;
        $<HTMLButtonElement>('[data-cancel]').textContent = state.busy === 'cancelling' ? 'Cancelando...' : 'Cancelar operación';
        for (const button of $$<HTMLButtonElement>('[data-check]')) {
          button.textContent = state.busy === 'checking' ? 'Consultando...' : 'Consultar estado';
        }
        $('[data-polling]').textContent = step === 'select' && state.polling
          ? 'El estado se actualiza automáticamente mientras la transacción está en curso.' : '';
        $('[data-processing-instrument]').textContent = chosen ? `Instrumento de prueba: ${chosen.label}.` : '';

        // The result the server answered: its reason, the receipt only for a confirmed approval.
        if (step === 'result') {
          $('[data-result-title]').textContent = title;
          $('[data-result-text]').textContent = text;
          const reason = resultReasonText(transaction);
          $('[data-result-reason]').textContent = reason ?? '';
          show($('[data-result-reason]'), reason !== null);
          const approved = transaction.status === 'APPROVED' && transaction.payment_id !== null;
          const paymentLink = $<HTMLAnchorElement>('[data-payment-link]');
          if (approved) paymentLink.href = paymentPath(transaction.payment_id!);
          show(paymentLink, approved);
          const receiptLink = $<HTMLAnchorElement>('[data-receipt-link]');
          const receipt = receiptLinkOf(transaction);
          if (receipt) receiptLink.href = receipt;
          show(receiptLink, receipt !== null);
          show($('[data-history-link]'), approved);
          const retryable = isRetryable(transaction);
          show($('[data-retry-box]'), retryable);
          $('[data-retry-hint]').textContent = retryable ? retryHint(transaction) : '';
          $<HTMLButtonElement>('[data-retry-another]').textContent =
            state.busy === 'retrying' || state.busy === 'opening' ? 'Iniciando una nueva transacción...' : 'Intentar con otro instrumento';
        }
      }

      // Really disabled while a request runs: no second POST. Each action also needs its own conditions.
      for (const button of $$<HTMLButtonElement>('button:not([data-cancel-keep])')) button.disabled = busy || state.sessionExpired;
      $<HTMLButtonElement>('[data-process]').disabled = !canProcess(state);
      $<HTMLButtonElement>('[data-cancel]').disabled = !canCancel(state);
      $<HTMLButtonElement>('[data-retry-another]').disabled = !canRetryWithAnother(state);
      page.setAttribute('aria-busy', String(busy));

      // Focus moves to the heading when the screen changes (a new view or step, a transaction that ended).
      const key = view.kind === 'transaction' ? `${step}:${view.transaction.id}:${view.transaction.status}` : view.kind;
      if (key !== shown) {
        const previous = shown;
        shown = key;
        const target = view.kind === 'transaction' ? `[data-step="${step}"] [data-focus]` : `[data-section="${view.kind}"] [data-focus]`;
        if (previous && view.kind !== 'loading') page.querySelector<HTMLElement>(target)?.focus();
      }
      // A new error is announced and focused once.
      if (state.notice !== notified) {
        notified = state.notice;
        if (error) errorBox.focus();
      }
    }

    const flow = createDemoCheckoutFlow({
      api: {
        get: getDemoPayment,
        list: listPayableObligations,
        instruments: listDemoInstruments,
        complete: (id, instrumentId) => completeDemoPayment(id, instrumentId, csrfToken),
        cancel: (id) => cancelDemoPayment(id, csrfToken),
        start: (chargeId, amount) => startDemoPayment(chargeId, amount, csrfToken)
      },
      render,
      navigate: (path) => window.location.assign(path)
    });

    $('[data-instruments]').addEventListener('change', (event) => {
      const input = (event.target as Element).closest<HTMLInputElement>('input[name="demo-instrument"]');
      if (input) flow.selectInstrument(input.value);
    });
    $('[data-instruments-retry]').addEventListener('click', () => void flow.retryInstruments());
    $('[data-process]').addEventListener('click', () => void flow.process());
    for (const button of $$<HTMLButtonElement>('[data-check]')) button.addEventListener('click', () => void flow.refresh());
    $('[data-retry]').addEventListener('click', () => void flow.retry());
    $('[data-retry-another]').addEventListener('click', () => void flow.retryWithAnother());
    $('[data-cancel]').addEventListener('click', () => {
      if (canCancel(flow.state)) dialog.showModal();
    });
    $('[data-cancel-keep]').addEventListener('click', () => dialog.close());
    $('[data-cancel-ok]').addEventListener('click', () => {
      dialog.close();
      void flow.cancel();
    });
    window.addEventListener('pagehide', () => flow.dispose());

    // ?resumed=1 (opened for a transaction already in progress): said once, then removed from the URL.
    const url = new URL(window.location.href);
    const resumed = parseResumedParam(url.search);
    if (resumed) {
      url.searchParams.delete('resumed');
      history.replaceState(null, '', url);
    }
    void flow.init(parseTransactionParam(url.search), { resumed });
  }
</script>
