---
import Layout from '../layouts/Layout.astro';

// HU-016. Public page: the token travels in the URL fragment (#token=...),
// which the browser never sends to the server, so this HTML never contains it.
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const inputClass =
  'mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/30';
const labelClass = 'block text-sm font-medium text-slate-700';
const errorClass = 'mt-1 hidden text-sm text-red-700';
const noticeTitle = 'text-lg font-semibold text-slate-900';
const linkButton =
  'inline-block rounded-lg bg-emerald-700 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700';
const textLink =
  'inline-block rounded text-sm font-medium text-emerald-800 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600';
---

<Layout title="Restablecer contraseña — SoftPh-Académico">
  <main class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-4 py-12">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8" data-reset>
      <p class="text-sm font-medium text-emerald-700">Urbanización San Joaquín</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight">Restablecer contraseña</h1>

      <div aria-live="polite">
        <div data-view="verifying" class="mt-6 flex items-center gap-3 text-slate-600">
          <span class="inline-block h-4 w-4 animate-spin rounded-full border-2 border-emerald-600 border-t-transparent" aria-hidden="true"></span>
          <p>Verificando el enlace…</p>
        </div>
        <div data-view="invalid" class="mt-6 hidden space-y-3" role="alert">
          <p class={noticeTitle}>El enlace no es válido</p>
          <p class="text-slate-600">Revisa que abriste el enlace completo del correo o solicita uno nuevo.</p>
          <a href="/forgot-password" class={textLink}>Solicitar un enlace nuevo</a>
        </div>
        <div data-view="expired" class="mt-6 hidden space-y-3" role="alert">
          <p class={noticeTitle}>El enlace venció</p>
          <p class="text-slate-600">Los enlaces para restablecer la contraseña duran 1 hora. Solicita uno nuevo.</p>
          <a href="/forgot-password" class={textLink}>Solicitar un enlace nuevo</a>
        </div>
        <div data-view="used" class="mt-6 hidden space-y-3" role="alert">
          <p class={noticeTitle}>Este enlace ya fue utilizado</p>
          <p class="text-slate-600">Cada enlace sirve una sola vez. Si necesitas cambiar tu contraseña otra vez, solicita uno nuevo.</p>
          <a href="/login" class={textLink}>Iniciar sesión</a>
        </div>
        <div data-view="revoked" class="mt-6 hidden space-y-3" role="alert">
          <p class={noticeTitle}>Este enlace fue reemplazado</p>
          <p class="text-slate-600">Solicitaste un enlace más reciente. Usa el último correo que recibiste o solicita uno nuevo.</p>
          <a href="/forgot-password" class={textLink}>Solicitar un enlace nuevo</a>
        </div>
        <div data-view="error" class="mt-6 hidden space-y-2" role="alert">
          <p class={noticeTitle}>No pudimos completar la solicitud</p>
          <p data-error-message class="text-slate-600"></p>
        </div>
        <div data-view="done" class="mt-6 hidden space-y-3 rounded-xl border border-emerald-200 bg-emerald-50 p-4" role="status">
          <p class="text-lg font-semibold text-emerald-900">Tu contraseña fue actualizada correctamente.</p>
          <p class="text-emerald-900">
            Por seguridad cerramos las sesiones que tenías abiertas. Inicia sesión con tu contraseña nueva.
          </p>
          <a href="/login" class={linkButton}>Iniciar sesión</a>
        </div>
      </div>

      <form data-view="ready" data-reset-form class="mt-6 hidden space-y-5" novalidate>
        <p class="text-sm text-slate-600">Crea una contraseña nueva para tu cuenta. El enlace vence el <span data-expires></span>.</p>
        <div data-form-alert role="alert" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"></div>
        <div>
          <label for="password" class={labelClass}>Nueva contraseña</label>
          <input id="password" name="password" type="password" autocomplete="new-password" required maxlength="128" aria-describedby="password-hint" class={inputClass} />
          <p id="password-hint" class="mt-1 text-sm text-slate-500">Entre 12 y 128 caracteres. Puedes usar una frase.</p>
          <p id="password-error" data-error-for="password" class={errorClass}></p>
        </div>
        <div>
          <label for="password_confirmation" class={labelClass}>Confirmar nueva contraseña</label>
          <input id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" required maxlength="128" class={inputClass} />
          <p id="password_confirmation-error" data-error-for="password_confirmation" class={errorClass}></p>
        </div>
        <button
          type="submit"
          class="w-full rounded-lg bg-emerald-700 px-4 py-2.5 font-medium text-white hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 disabled:opacity-60"
        >
          Actualizar contraseña
        </button>
      </form>
    </div>
  </main>
</Layout>

<script>
  import { confirmPasswordReset, verifyPasswordReset } from '../lib/api/password-reset';
  import { createResetFlow, type ResetState } from '../lib/auth/password-reset';
  import { formatBogota } from '../lib/residents/invitation-form';

  const FIELDS = ['password', 'password_confirmation'] as const;
  const root = document.querySelector<HTMLElement>('[data-reset]')!;
  const form = root.querySelector<HTMLFormElement>('[data-reset-form]')!;
  const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const formAlert = form.querySelector<HTMLElement>('[data-form-alert]')!;

  function show(element: HTMLElement, message: string | null): void {
    element.textContent = message ?? '';
    element.classList.toggle('hidden', !message);
  }

  function render(state: ResetState): void {
    const view = state.kind === 'updating' ? 'ready' : state.kind;
    root.querySelectorAll<HTMLElement>('[data-view]').forEach((element) => {
      element.classList.toggle('hidden', element.dataset.view !== view);
    });
    if (state.kind === 'error') {
      root.querySelector<HTMLElement>('[data-error-message]')!.textContent = state.message;
    }
    if (state.kind === 'ready' || state.kind === 'updating') {
      root.querySelector<HTMLElement>('[data-expires]')!.textContent = formatBogota(state.preview.expires_at);
    }
    const updating = state.kind === 'updating';
    submit.disabled = updating;
    submit.textContent = updating ? 'Actualizando…' : 'Actualizar contraseña';
    form.setAttribute('aria-busy', updating ? 'true' : 'false');
    if (state.kind === 'ready') {
      show(formAlert, state.alert);
      let first: HTMLInputElement | null = null;
      for (const field of FIELDS) {
        const input = form.elements.namedItem(field) as HTMLInputElement;
        const error = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`)!;
        const message = state.errors[field] ?? null;
        show(error, message);
        input.setAttribute('aria-invalid', message ? 'true' : 'false');
        const hint = field === 'password' ? 'password-hint' : '';
        input.setAttribute('aria-describedby', [hint, message ? error.id : ''].filter(Boolean).join(' '));
        if (message) {
          first ??= input;
        }
      }
      first?.focus();
    }
    if (state.kind === 'done') {
      form.reset(); // the new password does not stay in the page
    }
  }

  const flow = createResetFlow({
    verify: verifyPasswordReset,
    confirm: confirmPasswordReset,
    // Remove the token from the address bar (and history) before anything else.
    clearToken: () => history.replaceState(null, '', window.location.pathname + window.location.search),
    render
  });

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement).value;
    void flow.submit(value('password'), value('password_confirmation'));
  });

  void flow.start(window.location.hash);
</script>
