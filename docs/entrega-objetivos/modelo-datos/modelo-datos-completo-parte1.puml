@startuml
' Parte 1 de 2 del modelo lógico completo (Anexo B), generada por scripts/dividir_modelo_datos.py
' a partir de modelo-datos-completo.puml: solo las columnas clave (PK, FK, UK), sin su tipo, y
' todas las relaciones de sus tablas con su cardinalidad. Pensada para una hoja carta horizontal.
skinparam dpi 300
skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam class {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}
hide circle
hide methods
top to bottom direction
skinparam nodesep 10
skinparam ranksep 10
title Modelo lógico de datos de SoftPh · Parte 1 de 2: usuarios, seguridad, estructura e invitaciones (solo columnas clave)
entity "login_throttles (5)" as login_throttles {
  *identifier_hash <<PK>>
}
entity "blocks (6)" as blocks {
  *id <<PK>>
}
entity "towers (7)" as towers {
  *id <<PK>>
  --
  *block_id <<FK>>
}
entity "units (7)" as units {
  *id <<PK>>
  --
  *tower_id <<FK>>
}
entity "resident_invitations (13)" as resident_invitations {
  *id <<PK>>
  --
  *token_hash <<UK>>
  *user_id <<FK>>
  *unit_id <<FK>>
  *invited_by_user_id <<FK>>
}
entity "resident_units (6)" as resident_units {
  *id <<PK>>
  --
  *user_id <<FK>>
  *unit_id <<FK>>
  *invitation_id <<FK,UK>>
}
entity "users (11)" as users {
  *id <<PK>>
  --
  *email <<UK>>
  document_number <<UK>>
}
entity "sessions (7)" as sessions {
  *id <<PK>>
  --
  *user_id <<FK>>
  *token_hash <<UK>>
}
entity "password_reset_tokens (7)" as password_reset_tokens {
  *id <<PK>>
  --
  *user_id <<FK>>
  *token_hash <<UK>>
}
entity "audit_logs (8)" as audit_logs {
  *id <<PK>>
  --
  actor_user_id <<FK>>
}
users |o---o{ audit_logs
users ||--o{ password_reset_tokens
users ||--o{ resident_invitations : "invited_by_user_id"
units ||--o{ resident_invitations
users ||--o{ resident_invitations : "user_id"
resident_invitations ||--o| resident_units
units ||--o{ resident_units
users ||--o{ resident_units
users ||--o{ sessions
blocks ||-o{ towers : "      "
towers ||-o{ units : "      "
entity "Leyenda" as leyenda #FFFFFF {
  Solo columnas clave, sin su tipo
  (todas las columnas: Figuras 11 a 13).
  (N): columnas de la tabla, sin las generadas.
  MySQL 8 · Alembic d33ea6140186.
  ● NOT NULL · <<PK>> primaria · <<FK>> foránea
  <<UK>> única · Etiqueta: la columna FK, cuando hay
  dos relaciones entre las mismas tablas.
  || uno · |o cero o uno · o{ cero o muchos
}
password_reset_tokens -[hidden]-> leyenda
resident_units -[hidden]-> login_throttles
@enduml
