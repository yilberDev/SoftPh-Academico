@startuml
' Parte 2 de 2 del modelo lógico completo (Anexo B), generada por scripts/dividir_modelo_datos.py
' a partir de modelo-datos-completo.puml: solo las columnas clave (PK, FK, UK), sin su tipo, y
' todas las relaciones de sus tablas con su cardinalidad. Pensada para una hoja carta horizontal.
skinparam dpi 300
skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam class {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}
hide circle
hide methods
top to bottom direction
skinparam nodesep 6
skinparam ranksep 10
' Título (no se dibuja; lo pone el pie de figura del informe): Modelo lógico de datos de SoftPh · Parte 2 de 2: finanzas y comunicación (solo columnas clave)
entity "units (parte 1)" as units #DDDDDD {
  *id <<PK>>
}
entity "charges (10)" as charges {
  *id <<PK>>
  --
  *unit_id <<FK>>
  source_charge_id <<FK,UK>>
  *created_by_user_id <<FK>>
}
entity "charges: origen\nde la mora" as charges_origen #DDDDDD {
  *id <<PK>>
}
entity "payment_allocations (5)" as payment_allocations {
  *id <<PK>>
  --
  *payment_id <<FK>>
  *charge_id <<FK>>
}
entity "users (parte 1)" as users #DDDDDD {
  *id <<PK>>
}
entity "payments (18)" as payments {
  *id <<PK>>
  --
  *resident_id <<FK>>
  *unit_id <<FK>>
  *registered_by_user_id <<FK>>
}
entity "demo_payment_transactions (11)" as demo_payment_transactions {
  *id <<PK>>
  --
  *resident_id <<FK>>
  *charge_id <<FK>>
  *reference <<UK>>
  payment_id <<FK,UK>>
}
entity "feedback (13)" as feedback {
  *id <<PK>>
  --
  *resident_id <<FK>>
}
entity "notifications (12)" as notifications {
  *id <<PK>>
  --
  *resident_id <<FK>>
  *event_key <<UK>>
}
users ||--o{ charges
charges |o-o| charges_origen : "   source_charge_id   "
units ||--o{ charges
charges ||--o{ demo_payment_transactions
payments |o--o| demo_payment_transactions
users ||--o{ demo_payment_transactions
users ||--o{ feedback
users ||--o{ notifications
charges ||--o{ payment_allocations
payments ||--o{ payment_allocations
users ||--o{ payments : "registered_by_user_id"
users ||--o{ payments : "resident_id"
units ||--o{ payments
entity "Leyenda" as leyenda #FFFFFF {
  Solo columnas clave, sin su tipo
  (todas las columnas: Figuras 11 a 13).
  (N): columnas de la tabla, sin las generadas.
  MySQL 8 · Alembic d33ea6140186.
  En gris: tablas de la parte 1 (solo su PK) y charges
  como origen de su mora (la misma tabla).
  ● NOT NULL · <<PK>> primaria · <<FK>> foránea
  <<UK>> única · Etiqueta: la columna FK, cuando hay
  dos relaciones entre las mismas tablas.
  || uno · |o cero o uno · o{ cero o muchos
}
payment_allocations -[hidden]> leyenda
@enduml
